DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
CRON_SECRET="change-me"
BCRYPT_COST="12"
REMINDER_WEBHOOK_URL=""
INITIAL_ADMIN_NAME="系统管理员"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="12345678"
DEFAULT_INITIAL_PASSWORD="12345678"

# Cloudflare R2 / S3 object storage for PDF documents.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket"

# Optional: use this when connecting to another S3-compatible provider.
R2_ENDPOINT=""

# Do not configure public R2 URLs. Buckets must stay private; downloads use backend signed URLs.
