DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&uselibpqcompat=true"
DATABASE_POOL_MAX="2"
APP_URL="https://your-production-domain.example.com"
# Enable only when the application is reachable exclusively through a trusted
# reverse proxy that overwrites X-Real-IP and appends X-Forwarded-For.
TRUST_PROXY_HEADERS="false"
# Set to cloudflare only when Cloudflare is the trusted edge proxy.
TRUSTED_PROXY_PROVIDER=""
# Generate independently with: openssl rand -hex 32
CRON_SECRET=""
# 32 random bytes as 64 hexadecimal characters. Encrypts third-party credentials stored in settings.
SETTINGS_ENCRYPTION_KEY=""
SETTINGS_ENCRYPTION_KEY_ID="primary-v1"
# JSON key ring used only while rotating old keys, for example {"primary-v1":"old-key"}.
SETTINGS_ENCRYPTION_PREVIOUS_KEYS=""
BCRYPT_COST="12"
REMINDER_WEBHOOK_URL=""

# Optional bootstrap admin for an empty database.
# Production rejects admin@example.com, 12345678, admin123456 and password.
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Tencent Cloud COS private object storage (required).
COS_REGION="ap-shanghai"
COS_ENDPOINT="https://cos.ap-shanghai.myqcloud.com"
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-private-bucket-name-with-appid"

# Optional Tencent Cloud SMS credential override. Leave blank when credentials are stored encrypted in system settings.
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""

# Do not configure public object-storage URLs. Buckets must stay private; downloads use backend signed URLs.

# Local quotation preview only. Put this in .env.development.local, never in production.
# QUOTATION_FILE_STORAGE_DRIVER="local"

# Optional production CSP allowlists. Leave blank unless the browser must load a
# trusted external resource such as a company logo CDN. Separate sources with spaces.
CSP_CONNECT_SRC=""
CSP_IMG_SRC=""
CSP_FRAME_SRC=""
CSP_MEDIA_SRC=""

# Unified API rate limits, applied before business route handlers.
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_READ_LIMIT="1000"
API_RATE_LIMIT_WRITE_LIMIT="300"
API_RATE_LIMIT_UPLOAD_LIMIT="60"
API_RATE_LIMIT_MEMORY_MAX_BUCKETS="20000"
# Production requires Redis by default. Set true only for one self-hosted server
# running exactly one Node process. Never use on Vercel; add Redis before scaling.
SINGLE_INSTANCE_MEMORY_RATE_LIMIT="false"
# Distributed rate limit store. Required for Vercel and all multi-instance/process production.
# Upstash Redis REST variables are supported directly.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel Upstash Marketplace injects this pair automatically.
UPSTASH_REDIS_KV_REST_API_URL=""
UPSTASH_REDIS_KV_REST_API_TOKEN=""
# Optional aliases if you do not want to use Upstash variable names.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""
RATE_LIMIT_NAMESPACE="nextwood"
RATE_LIMIT_REDIS_TIMEOUT_MS="1500"
API_RATE_LIMIT_REGISTRATION_WINDOW_MS="900000"
API_RATE_LIMIT_REGISTRATION_LIMIT="5"

# Optional comma-separated HTTPS host allowlists for non-default Aliyun endpoints.
ALIYUN_OCR_ALLOWED_HOSTS=""
ALIYUN_DOCMIND_ENDPOINT_ALLOWED_HOSTS=""
ALIYUN_DOCMIND_OUTPUT_ALLOWED_HOSTS=""

# Resend mail service. Keep the sending key, inbound full-access key, and
# webhook signing secret separate; all three are server-only secrets.
RESEND_API_KEY=""
RESEND_FROM="NEXTWOOD CRM <crm@send.nextwood.com>"
# Full-access Resend API key used to retrieve received email bodies and attachments.
# Never expose this value through a NEXT_PUBLIC_* variable or commit a real key.
RESEND_INBOUND_API_KEY=""
# Signing secret from the Resend email.received webhook (placeholder only).
RESEND_WEBHOOK_SECRET=""
# CRM mailbox domain. Resend Receiving and its MX record must be verified for this exact domain.
CRM_EMAIL_DOMAIN="send.nextwood.com"
# Optional override; defaults to https://api.resend.com/emails
RESEND_EMAIL_ENDPOINT=""
