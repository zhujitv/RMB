page {
  min-height: 100%;
  background: #f4f7f5;
  color: #183229;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.page { padding: 28rpx; }
.card { background: #fff; border: 1rpx solid #e3ebe7; border-radius: 24rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 10rpx 30rpx rgba(22, 67, 51, .05); }
.muted { color: #73837c; }
.primary { color: #157a55; }
.danger { color: #c23b36; }
.button { border: 0; border-radius: 18rpx; background: #157a55; color: #fff; font-size: 28rpx; line-height: 88rpx; height: 88rpx; }
.button::after { border: 0; }
.button.secondary { background: #e8f3ee; color: #126344; }
.button.ghost { background: #fff; color: #456057; border: 1rpx solid #dbe5e0; }
.empty { text-align: center; padding: 100rpx 20rpx; color: #84928c; }
.tag { display: inline-block; padding: 7rpx 15rpx; border-radius: 999rpx; background: #edf5f1; color: #217153; font-size: 22rpx; margin-right: 10rpx; }
.tag.warning { background: #fff0e6; color: #b75318; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
