<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取报价详情…</view>
  <block wx:elif="{{quotation}}">
    <view class="hero"><view class="eyebrow">{{quotation.statusDisplay}} · V{{quotation.currentVersionNumber}}</view><view class="title">{{quotation.quoteNo}}</view><view class="subtitle">{{quotation.customerShortName || quotation.customerName}}</view></view>
    <view class="actions"><button wx:if="{{canEdit}}" class="secondary" bindtap="edit">编辑新版本</button><button wx:if="{{canOperate}}" class="primary" bindtap="operate">发送 / 客户确认</button></view>
    <view class="card details"><view><text>报价金额</text><strong>{{version.currency}} {{version.totalAmount}}</strong></view><view><text>报价日期</text><strong>{{version.quoteDate || '-'}}</strong></view><view><text>有效期至</text><strong>{{version.validUntil || '-'}}</strong></view><view><text>贸易条款</text><strong>{{version.tradeTerm || '-'}}</strong></view><view><text>付款条款</text><strong>{{version.paymentTerm || '-'}}</strong></view><view><text>预计交期</text><strong>{{version.leadTimeDays === null ? '-' : version.leadTimeDays + ' 天'}}</strong></view></view>
    <view class="section-title block-title">报价明细</view><view wx:for="{{version.items}}" wx:key="id" class="card item"><view class="row"><strong>{{index + 1}}. {{item.productNameSnapshot || item.name}}</strong><text>{{version.currency}} {{item.amount}}</text></view><view class="muted">{{item.specificationSnapshot || item.specification}}</view><view class="numbers"><text>{{item.quantity}} {{item.unit}}</text><text>单价 {{item.unitPrice}}</text></view></view>
    <view wx:if="{{version.remark}}" class="card"><view class="section-title">备注</view><view class="muted">{{version.remark}}</view></view>
  </block>
</view>
