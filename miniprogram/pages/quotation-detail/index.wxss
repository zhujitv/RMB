.hero{background:linear-gradient(145deg,#12372a,#1d6a4e);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:20rpx}.hero .subtitle{color:rgba(255,255,255,.75)}.eyebrow{font-size:22rpx;opacity:.8;margin-bottom:9rpx}.edit{margin-bottom:22rpx}.details view{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #edf0ee}.details view:last-child{border:0}.details text{color:#718078}.details strong{text-align:right}.block-title{margin:34rpx 4rpx 18rpx}.item .row strong{max-width:72%}.item .row>text{color:#176c4e;font-weight:700}.numbers{display:flex;justify-content:space-between;margin-top:18rpx;color:#53645c}
