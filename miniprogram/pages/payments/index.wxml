<view class="page"><view class="hero"><view class="eyebrow">财务收款</view><view class="title">收款管理</view><view class="subtitle">登记后自动同步订单收款状态</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="metrics"><view class="card"><text>已到账</text><strong>¥ {{summary.arrivedAmountCny || 0}}</strong></view><view class="card"><text>待确认</text><strong>¥ {{summary.pendingAmountCny || 0}}</strong></view></view><button class="primary create" bindtap="create">＋ 登记客户收款</button><input class="input search" value="{{keyword}}" bindinput="search" placeholder="搜索订单、客户或银行流水"/><view wx:if="{{loading}}" class="loading">正在读取收款记录…</view><view wx:elif="{{!shown.length}}" class="card empty">暂无收款记录。</view><view wx:for="{{shown}}" wx:key="id" class="card"><view class="row"><strong>{{item.orderNo || '-'}}</strong><view class="status">{{item.status}}</view></view><view class="customer">{{item.customerName || item.customerShortName}}</view><view class="amount">{{item.currency}} {{item.amount}}</view><view class="line"><text>{{item.paymentType}}</text><text>{{item.paymentDate}}</text></view><view wx:if="{{item.bankReference}}" class="muted">银行流水：{{item.bankReference}}</view></view></view>
