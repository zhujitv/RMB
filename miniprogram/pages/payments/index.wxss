.hero{background:linear-gradient(145deg,#253f64,#315f91);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:20rpx}.hero .subtitle{color:rgba(255,255,255,.74)}.eyebrow{font-size:22rpx;opacity:.78;margin-bottom:9rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.metrics .card{padding:20rpx}.metrics text{display:block;color:#74827b;font-size:22rpx}.metrics strong{display:block;margin-top:8rpx;color:#184d3b}.create{margin-bottom:16rpx}.search{margin:0 0 22rpx;background:#fff}.customer{color:#6c7c74;margin-top:12rpx}.amount{font-size:38rpx;color:#176c4e;font-weight:700;margin:18rpx 0}.line{display:flex;justify-content:space-between;margin-bottom:12rpx}
