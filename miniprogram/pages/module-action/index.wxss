.textarea{width:100%;min-height:160rpx;box-sizing:border-box;padding:20rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin-top:12rpx}.textarea.small{min-height:96rpx}.textarea.mail{min-height:300rpx}.picker{min-height:78rpx;box-sizing:border-box;padding:20rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin:12rpx 0 18rpx}.submit{margin-top:18rpx}.two,.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:18rpx}.wide{grid-column:1/-1}.line{display:flex;justify-content:space-between;gap:22rpx;padding:15rpx 0;border-top:1rpx solid #edf0ee}.line text{color:#718078}.line strong{text-align:right}
