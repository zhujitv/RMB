<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在读取业务详情…</view><block wx:else><view wx:if="{{key === 'customerCommunication'}}" class="card"><view class="section-title">发送客户清关资料</view><text class="label">收件邮箱</text><textarea class="textarea small" data-field="recipientEmails" value="{{recipientEmails}}" bindinput="input"/><text class="label">抄送邮箱</text><textarea class="textarea small" data-field="ccEmails" value="{{ccEmails}}" bindinput="input"/><text class="label">邮件标题</text><input class="input" data-field="emailSubject" value="{{emailSubject}}" bindinput="input"/><text class="label">邮件正文</text><textarea class="textarea mail" data-field="emailBody" value="{{emailBody}}" bindinput="input"/><button class="primary submit" loading="{{acting}}" bindtap="sendCommunication">发送邮件和附件</button><text class="label">线下发送备注</text><input class="input" data-field="manualRemark" value="{{manualRemark}}" bindinput="input"/><view class="two"><button class="secondary" bindtap="markSent">登记线下已发送</button><button class="danger" bindtap="unmarkSent">取消线下标记</button></view></view><view wx:if="{{key === 'oceanControlTower'}}" class="card"><view class="section-title">运输节点操作</view><button class="primary" loading="{{acting}}" bindtap="syncOcean">立即同步 Freightower</button></view><view wx:if="{{key === 'costs'}}" class="card"><view class="section-title">成本付款与生命周期</view><text class="label">付款日期</text><picker mode="date" value="{{paymentDate}}" data-field="paymentDate" bindchange="input"><view class="picker">{{paymentDate}}</view></picker><view class="two"><button class="primary" bindtap="markCostPaid">标记已付款</button><button class="secondary" bindtap="cancelCostPaid">取消付款</button></view><button class="danger submit" bindtap="voidCost">作废成本</button></view><view wx:if="{{key === 'logisticsFees'}}" class="card"><view class="section-title">物流费用工作流</view><text class="label">付款日期</text><picker mode="date" value="{{paymentDate}}" data-field="paymentDate" bindchange="input"><view class="picker">{{paymentDate}}</view></picker><view class="action-grid"><button class="secondary" data-action="submitBill" bindtap="logisticsAction">提交审核</button><button class="primary" data-action="approve" bindtap="logisticsAction">审核通过</button><button class="danger" data-action="reject" bindtap="logisticsAction">驳回</button><button class="primary" data-action="markPaid" bindtap="logisticsAction">标记付款</button><button class="secondary" data-action="reversePayment" bindtap="logisticsAction">冲销付款</button><button class="secondary" data-action="withdraw" bindtap="logisticsAction">撤回草稿</button><button class="danger wide" data-action="voidBill" bindtap="logisticsAction">作废账单</button></view></view><view wx:if="{{key === 'taxRefund'}}" class="card"><view class="section-title">退税资料工作流</view><button class="secondary" bindtap="refreshTax">重新计算完整度</button><button class="primary submit" bindtap="submitTax">提交并归档退税资料</button><button class="danger submit" bindtap="cancelTax">取消退税归档</button></view><view class="card"><view class="section-title">当前记录</view><view wx:for="{{lines}}" wx:key="label" class="line"><text>{{item.label}}</text><strong>{{item.value}}</strong></view></view></block></view>
