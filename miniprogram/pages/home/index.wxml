<view class="page">
  <view class="hero">
    <view class="eyebrow">NEXTWOOD LOGISTICS</view>
    <view class="welcome">{{user.name || '您好'}}，物流动态尽在掌握</view>
    <view class="updated">更新于 {{updatedAt || '-'}}</view>
  </view>

  <view class="stats-grid">
    <view class="stat"><view class="number">{{stats.inTransitCount || 0}}</view><view class="label">运输中</view></view>
    <view class="stat warn"><view class="number">{{stats.dumpingWarningCount || 0}}</view><view class="label">甩柜预警</view></view>
    <view class="stat"><view class="number">{{stats.soonArrivingCount || 0}}</view><view class="label">即将到港</view></view>
    <view class="stat"><view class="number">{{stats.syncFailedCount || 0}}</view><view class="label">同步异常</view></view>
  </view>

  <view class="card subscription" wx:if="{{subscription.enabled}}">
    <view class="row">
      <view>
        <view class="card-title">物流变化微信提醒</view>
        <view class="muted small">当前可用通知次数：{{subscription.availableGrantCount || 0}}</view>
      </view>
      <view class="bell">◉</view>
    </view>
    <button class="button secondary subscribe-button" bindtap="subscribe">授权一次物流提醒</button>
    <view class="note">微信要求每次授权由您主动点击；每次授权通常可接收 1 条通知。</view>
  </view>

  <view class="card action" bindtap="openTrackings">
    <view><view class="card-title">查看全部运输</view><view class="muted small">订单、提单、柜号和完整节点时间轴</view></view>
    <view class="arrow">›</view>
  </view>
</view>
