<view class="page">
  <view class="hero">
    <view class="eyebrow">RMB 移动工作台</view>
    <view class="title">{{user ? user.name : '正在读取账号'}}</view>
    <view class="subtitle">{{user ? user.role + ' · 已按账号权限加载功能' : ''}}</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在同步待办…</view>
  <block wx:else>
    <view wx:if="{{hasPurchaseOrders || hasDocuments}}" class="metrics">
      <view wx:if="{{hasPurchaseOrders}}" class="metric card" bindtap="openPurchaseOrders">
        <view class="metric-value">{{purchaseTotal}}</view><view class="metric-label">工厂采购单</view>
      </view>
      <view wx:if="{{hasDocuments}}" class="metric card" bindtap="openDocuments">
        <view class="metric-value">{{documentPending}}</view><view class="metric-label">待回传资料</view>
      </view>
    </view>
    <view class="list-heading"><view class="section-title">我的业务模块</view><view class="muted">共 {{modules.length}} 项</view></view>
    <view wx:if="{{!modules.length}}" class="card empty">当前账号暂未配置业务模块，请联系管理员。</view>
    <view wx:for="{{modules}}" wx:key="key" class="card action" data-key="{{item.key}}" bindtap="openModule">
      <view><view class="section-title">{{item.label}}</view><view class="muted">{{item.description}}</view></view>
      <view class="action-side"><view class="module-status {{item.available ? 'available' : ''}}">{{item.status}}</view><text>›</text></view>
    </view>
    <view class="card action" bindtap="openProfile"><view><view class="section-title">账号与帮助</view><view class="muted">查看账号信息、权限身份并退出登录</view></view><text>›</text></view>
  </block>
</view>
