.picker{min-height:78rpx;box-sizing:border-box;padding:22rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin-top:12rpx;display:flex;justify-content:space-between}.two{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.three{display:grid;grid-template-columns:.8fr 1fr 1fr;gap:12rpx}.textarea{min-height:130rpx;width:100%;box-sizing:border-box;padding:20rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin-top:12rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin:30rpx 4rpx 18rpx}.section-head .section-title{margin:0}.mini,.remove{font-size:22rpx;line-height:56rpx;min-height:56rpx;margin:0;padding:0 18rpx}.remove{color:#a8342a;background:#fff0ef}.item{border-left:6rpx solid #276d8b}.submit{margin:32rpx 0 50rpx}
