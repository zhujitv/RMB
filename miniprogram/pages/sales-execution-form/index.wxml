<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在准备销售执行表单…</view><block wx:else><view class="card"><view class="section-title">订单信息</view><text class="label">客户</text><picker mode="selector" range="{{customerNames}}" value="{{customerIndex}}" bindchange="chooseCustomer"><view class="picker">{{customerIndex >= 0 ? customerNames[customerIndex] : '请选择客户'}}<text>⌄</text></view></picker><text class="label">业务主体</text><picker mode="selector" range="{{entityNames}}" value="{{entityIndex}}" bindchange="chooseEntity"><view class="picker">{{entityIndex >= 0 ? entityNames[entityIndex] : '请选择业务主体'}}<text>⌄</text></view></picker><view class="two"><view><text class="label">销售币种</text><picker mode="selector" range="{{currencies}}" value="{{currencyIndex}}" bindchange="chooseCurrency"><view class="picker">{{currencies[currencyIndex]}}⌄</view></picker></view><view><text class="label">贸易条款</text><picker mode="selector" range="{{tradeTerms}}" value="{{tradeTermIndex}}" bindchange="chooseTradeTerm"><view class="picker">{{tradeTerms[tradeTermIndex]}}⌄</view></picker></view></view><text class="label">客户订单号</text><input class="input" data-field="customerOrderNo" value="{{form.customerOrderNo}}" bindinput="onFormInput" placeholder="客户 PO / 合同号"/><text class="label">客户要求交货日期</text><picker mode="date" value="{{form.requestedDeliveryDate}}" data-field="requestedDeliveryDate" bindchange="onFormInput"><view class="picker">{{form.requestedDeliveryDate}}</view></picker><text class="label">付款条款</text><input class="input" data-field="paymentTerm" value="{{form.paymentTerm}}" bindinput="onFormInput"/><text class="label">备注</text><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="onFormInput"/></view><view class="section-head"><view class="section-title">销售与工厂分配</view><button class="secondary mini" bindtap="addItem">＋ 添加</button></view><view wx:for="{{items}}" wx:key="key" class="card item"><view class="row"><strong>第 {{index + 1}} 项</strong><button wx:if="{{items.length > 1}}" class="remove" data-index="{{index}}" bindtap="removeItem">删除</button></view><text class="label">产品描述</text><input class="input" data-index="{{index}}" data-field="name" value="{{item.name}}" bindinput="onItemInput"/><text class="label">规格</text><input class="input" data-index="{{index}}" data-field="specification" value="{{item.specification}}" bindinput="onItemInput"/><view class="three"><view><text class="label">单位</text><input class="input" data-index="{{index}}" data-field="unit" value="{{item.unit}}" bindinput="onItemInput"/></view><view><text class="label">数量</text><input class="input" type="digit" data-index="{{index}}" data-field="quantity" value="{{item.quantity}}" bindinput="onItemInput"/></view><view><text class="label">销售单价</text><input class="input" type="digit" data-index="{{index}}" data-field="salesUnitPrice" value="{{item.salesUnitPrice}}" bindinput="onItemInput"/></view></view><text class="label">分配工厂（默认分配全部数量）</text><picker mode="selector" range="{{supplierNames}}" value="{{item.supplierIndex}}" data-index="{{index}}" bindchange="chooseSupplier"><view class="picker">{{item.supplierIndex >= 0 ? supplierNames[item.supplierIndex] : '请选择产品供应商'}}<text>⌄</text></view></picker><text class="label">采购单价（CNY，可暂不填写）</text><input class="input" type="digit" data-index="{{index}}" data-field="purchaseUnitPrice" value="{{item.purchaseUnitPrice}}" bindinput="onItemInput"/></view><button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{saving ? '保存中…' : '保存销售执行草稿'}}</button></block></view>
