.summary { background: linear-gradient(150deg, #fff, #edf6f1); }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 28rpx; }
.grid text { display: block; color: #718078; font-size: 23rpx; margin-bottom: 8rpx; }
.grid strong { display: block; font-weight: 650; }
.remark { background: #f4f7f5; padding: 18rpx; border-radius: 12rpx; margin-top: 24rpx; line-height: 1.6; }
.product { border-top: 1rpx solid #e9eeeb; padding: 24rpx 0; }
.product:first-of-type { border-top: 0; }
.product-name { font-weight: 650; line-height: 1.55; margin-bottom: 10rpx; }
.action-tabs { display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: 10rpx; }
.tab { text-align: center; padding: 17rpx 8rpx; background: #edf1ef; border-radius: 12rpx; color: #596961; }
.tab.active { background: #176c4e; color: #fff; }
.tab.danger-tab { background: #a83a31; }
.textarea { width: 100%; min-height: 150rpx; margin-bottom: 24rpx; }
.progress-head { color: #176c4e; margin-bottom: 10rpx; }
