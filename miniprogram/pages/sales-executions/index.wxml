<view class="page"><view class="hero"><view class="eyebrow">销售环节 · 第二步</view><view class="title">销售执行</view><view class="subtitle">承接已接受报价或直接订单，形成客户销售明细与工厂采购分配。</view></view><view class="toolbar card"><input class="search" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" confirm-type="search" placeholder="搜索执行单号、客户订单号或客户"/><button class="primary small" bindtap="search">查询</button></view><picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus"><view class="filter card">状态：{{statusOptions[statusIndex]}}<text>⌄</text></view></picker><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取销售执行单…</view><block wx:else><button wx:if="{{canWrite}}" class="primary create" bindtap="create">＋ 直接创建销售执行草稿</button><view class="muted count">共 {{total}} 条</view><view wx:if="{{!rows.length}}" class="card empty">当前条件下没有销售执行单。</view><view wx:for="{{rows}}" wx:key="id" class="card execution" data-id="{{item.id}}" bindtap="open"><view class="row"><view><view class="section-title">{{item.executionNo}}</view><view class="muted">{{item.customerDisplay}} · {{item.customerOrderNo}}</view></view><view class="status">{{item.statusDisplay}}</view></view><view class="badges"><text>{{item.sourceDisplay}}</text><text>V{{item.currentVersionNumber}}</text></view><view class="metrics"><view><text>销售金额</text><strong>{{item.amountDisplay}}</strong></view><view><text>要求交货</text><strong>{{item.deliveryDisplay}}</strong></view></view></view><view wx:if="{{totalPages > 1}}" class="pagination"><button class="secondary small" disabled="{{page <= 1}}" bindtap="previousPage">上一页</button><text>{{page}} / {{totalPages}}</text><button class="secondary small" disabled="{{page >= totalPages}}" bindtap="nextPage">下一页</button></view></block></view>
