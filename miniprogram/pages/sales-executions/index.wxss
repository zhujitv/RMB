.hero{background:linear-gradient(145deg,#17384f,#236781);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:22rpx}.hero .subtitle{color:rgba(255,255,255,.76)}.eyebrow{font-size:22rpx;letter-spacing:2rpx;opacity:.75;margin-bottom:10rpx}.toolbar{display:flex;gap:14rpx;padding:16rpx}.search{flex:1;background:#f5f7f5;border-radius:12rpx;padding:0 18rpx;min-height:72rpx}.small{min-height:68rpx;line-height:68rpx;padding:0 24rpx;margin:0}.filter{display:flex;justify-content:space-between;padding:20rpx 24rpx}.create{margin-bottom:18rpx}.count{margin:12rpx 4rpx 18rpx}.execution .section-title{margin-bottom:5rpx}.badges{display:flex;gap:12rpx;margin-top:18rpx}.badges text{font-size:21rpx;background:#edf3f7;color:#315d75;border-radius:999rpx;padding:6rpx 13rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;border-top:1rpx solid #edf0ee;margin-top:18rpx;padding-top:18rpx}.metrics view{display:flex;flex-direction:column;gap:5rpx}.metrics text{font-size:22rpx;color:#7a8780}.pagination{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0}
