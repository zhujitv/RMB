<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在准备收款表单…</view><view wx:else class="card"><view class="section-title">登记客户收款</view><text class="label">关联订单</text><picker range="{{orderNames}}" value="{{orderIndex}}" bindchange="chooseOrder"><view class="picker">{{orderIndex >= 0 ? orderNames[orderIndex] : '请选择订单'}}<text>⌄</text></view></picker><view class="two"><view><text class="label">收款日期</text><picker mode="date" value="{{form.paymentDate}}" data-field="paymentDate" bindchange="input"><view class="picker">{{form.paymentDate}}</view></picker></view><view><text class="label">收款类型</text><picker range="{{types}}" value="{{typeIndex}}" bindchange="chooseType"><view class="picker">{{types[typeIndex]}}⌄</view></picker></view></view><text class="label">收款金额（{{form.currency}}）</text><input class="input" type="digit" data-field="amount" value="{{form.amount}}" bindinput="input"/><view wx:if="{{form.currency !== 'CNY'}}"><text class="label">汇率（兑人民币）</text><input class="input" type="digit" data-field="exchangeRate" value="{{form.exchangeRate}}" bindinput="input"/></view><text class="label">到账状态</text><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="chooseStatus"><view class="picker">{{statuses[statusIndex]}}⌄</view></picker><text class="label">银行流水号（可选）</text><input class="input" data-field="bankReference" value="{{form.bankReference}}" bindinput="input"/><text class="label">备注</text><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="input"/><button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存收款记录</button></view></view>
