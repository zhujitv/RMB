<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在准备业务表单…</view><view wx:else class="card"><view class="section-title">{{title}}</view><text class="label">关联订单</text><picker range="{{orderNames}}" value="{{orderIndex}}" bindchange="chooseOrder"><view class="picker">{{orderIndex >= 0 ? orderNames[orderIndex] : '请选择订单'}}<text>⌄</text></view></picker><block wx:if="{{kind !== 'domestic'}}"><text class="label">供应商</text><picker range="{{supplierNames}}" value="{{supplierIndex}}" bindchange="chooseSupplier"><view class="picker">{{supplierIndex >= 0 ? supplierNames[supplierIndex] : '请选择供应商'}}<text>⌄</text></view></picker><text class="label">{{kind === 'cost' ? '成本类型' : '物流费用类型'}}</text><picker wx:if="{{kind === 'cost'}}" range="{{costTypes}}" value="{{costTypeIndex}}" bindchange="chooseCostType"><view class="picker">{{costTypes[costTypeIndex]}}⌄</view></picker><picker wx:else range="{{logisticsTypes}}" value="{{logisticsTypeIndex}}" bindchange="chooseLogisticsType"><view class="picker">{{logisticsTypes[logisticsTypeIndex]}}⌄</view></picker><view class="two"><view><text class="label">币种</text><picker range="{{currencies}}" value="{{currencyIndex}}" bindchange="chooseCurrency"><view class="picker">{{currencies[currencyIndex]}}⌄</view></picker></view><view><text class="label">汇率</text><input class="input" type="digit" data-field="exchangeRate" value="{{form.exchangeRate}}" bindinput="input"/></view></view><text class="label">金额</text><input class="input" type="digit" data-field="amount" value="{{form.amount}}" bindinput="input"/><view wx:if="{{kind === 'logisticsFee'}}"><text class="label">适用柜量 / 数量</text><input class="input" type="digit" data-field="appliedContainerCount" value="{{form.appliedContainerCount}}" bindinput="input"/></view></block><block wx:else><text class="label">运输方式</text><picker range="{{transportTypes}}" value="{{transportIndex}}" bindchange="chooseTransport"><view class="picker">{{transportTypes[transportIndex]}}⌄</view></picker><block wx:if="{{form.transportType === 'EXPRESS'}}"><text class="label">快递单号</text><input class="input" data-field="expressTrackingNo" value="{{form.expressTrackingNo}}" bindinput="input"/></block><block wx:else><text class="label">车辆号码</text><input class="input" data-field="truckPlateNo" value="{{form.truckPlateNo}}" bindinput="input"/><text class="label">挂车号码（可选）</text><input class="input" data-field="trailerPlateNo" value="{{form.trailerPlateNo}}" bindinput="input"/><text class="label">出发日期</text><picker mode="date" value="{{form.departureDate}}" data-field="departureDate" bindchange="input"><view class="picker">{{form.departureDate}}</view></picker><text class="label">起运地</text><input class="input" data-field="departurePlace" value="{{form.departurePlace}}" bindinput="input"/></block><text class="label">到达地</text><input class="input" data-field="destinationPlace" value="{{form.destinationPlace}}" bindinput="input"/><text class="label">货物名称</text><input class="input" data-field="cargoDescription" value="{{form.cargoDescription}}" bindinput="input"/></block><text class="label">备注</text><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="input"/><button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存业务记录</button></view></view>
