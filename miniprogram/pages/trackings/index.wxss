.search-wrap { display: flex; gap: 12rpx; position: sticky; top: 0; z-index: 2; background: #f4f7f5; padding-bottom: 20rpx; }
.search { flex: 1; height: 76rpx; background: #fff; border: 1rpx solid #dbe6e0; border-radius: 16rpx; padding: 0 22rpx; box-sizing: border-box; }
.search-btn { width: 130rpx; height: 76rpx; line-height: 76rpx; border: 0; border-radius: 16rpx; background: #176f50; color: #fff; font-size: 26rpx; padding: 0; }
.search-btn::after { border: 0; }
.summary { font-size: 23rpx; margin-bottom: 15rpx; }
.tracking-card { background: #fff; border-radius: 22rpx; padding: 27rpx; margin-bottom: 18rpx; border: 1rpx solid #e0e9e4; }
.top { align-items: flex-start; }
.order-no { font-weight: 700; font-size: 31rpx; }
.status { background: #e7f4ee; color: #176f50; border-radius: 999rpx; padding: 7rpx 14rpx; font-size: 21rpx; max-width: 230rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status.warning { background: #fff0e5; color: #bd561a; }
.customer { color: #77877f; margin-top: 8rpx; font-size: 24rpx; }
.route { display: flex; justify-content: space-between; align-items: center; background: #f5f8f6; border-radius: 15rpx; padding: 18rpx; margin: 22rpx 0; font-size: 24rpx; }
.route text { flex: 1; }
.route text:last-child { text-align: right; }
.route .line { color: #68a68a; text-align: center; flex: .7; }
.details { color: #30483f; font-size: 24rpx; line-height: 1.9; }
.details .label { display: inline-block; width: 130rpx; color: #899790; }
