<view class="page">
  <view class="search-wrap">
    <input class="search" placeholder="搜索订单、提单、柜号" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search" />
    <button class="search-btn" bindtap="search">查询</button>
  </view>
  <view class="summary muted">共 {{rows.length}} 票运输</view>
  <view class="empty" wx:if="{{!loading && !rows.length}}">没有找到运输记录</view>
  <view class="tracking-card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <view class="row top">
      <view class="order-no">{{item.orderNo || '-'}}</view>
      <view class="status {{item.hasDumpingWarning ? 'warning' : ''}}">{{item.hasDumpingWarning ? '甩柜预警' : (item.currentStatus || item.statusLabel || '运输中')}}</view>
    </view>
    <view class="customer">{{item.customerShortName || item.customerName || '-'}}</view>
    <view class="route"><text>{{item.originName || '起运港未返回'}}</text><text class="line">——→</text><text>{{item.destinationName || '目的港未返回'}}</text></view>
    <view class="details">
      <view><text class="label">提单</text>{{item.masterBlNo || item.billOfLadingNo || '-'}}</view>
      <view><text class="label">船名航次</text>{{item.vesselName || '-'}} {{item.voyage || ''}}</view>
      <view><text class="label">预计到港</text>{{item.etaText || item.eta || '-'}}</view>
      <view><text class="label">最新节点</text>{{item.latestNodeDescription || item.lastEvent || '-'}}</view>
    </view>
  </view>
</view>
