.hero{background:linear-gradient(145deg,#332f4f,#665e92);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:20rpx}.hero .subtitle{color:rgba(255,255,255,.74)}.eyebrow{font-size:22rpx;opacity:.78;margin-bottom:9rpx}.picker{min-height:78rpx;box-sizing:border-box;padding:20rpx 22rpx;background:#fff;border:1rpx solid #dce4df;border-radius:14rpx;margin:18rpx 0 12rpx;display:flex;justify-content:space-between}.search{margin:0 0 22rpx;background:#fff}.line{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid #edf0ee;padding:15rpx 0}.line text{color:#718078}.line strong{text-align:right}
