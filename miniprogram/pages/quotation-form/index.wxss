.picker{min-height:78rpx;box-sizing:border-box;padding:22rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin-top:12rpx;display:flex;justify-content:space-between}.two{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.three{display:grid;grid-template-columns:.8fr 1fr 1fr;gap:12rpx}.textarea{min-height:150rpx;box-sizing:border-box;padding:20rpx 22rpx;background:#f6f8f6;border:1rpx solid #dce4df;border-radius:14rpx;margin-top:12rpx;width:100%}.section-head{display:flex;align-items:center;justify-content:space-between;margin:30rpx 4rpx 18rpx}.section-head .section-title{margin:0}.mini{font-size:23rpx;line-height:58rpx;min-height:58rpx;margin:0;padding:0 20rpx}.item{border-left:6rpx solid #1a7253}.remove{color:#a8342a;background:#fff0ef;font-size:22rpx;line-height:52rpx;min-height:52rpx;margin:0;padding:0 18rpx}.submit{margin:34rpx 0 50rpx}
