<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在准备报价表单…</view><block wx:else><view class="card"><view class="section-title">基础信息</view><text class="label">客户</text><picker disabled="{{!!id}}" mode="selector" range="{{customerNames}}" value="{{customerIndex}}" bindchange="chooseCustomer"><view class="picker">{{customerIndex >= 0 ? customerNames[customerIndex] : '请选择客户'}}<text>⌄</text></view></picker><text class="label">业务主体</text><picker disabled="{{!!id}}" mode="selector" range="{{entityNames}}" value="{{entityIndex}}" bindchange="chooseEntity"><view class="picker">{{entityIndex >= 0 ? entityNames[entityIndex] : '请选择业务主体'}}<text>⌄</text></view></picker><view class="two"><view><text class="label">币种</text><picker mode="selector" range="{{currencies}}" value="{{currencyIndex}}" bindchange="chooseCurrency"><view class="picker">{{currencies[currencyIndex]}}⌄</view></picker></view><view><text class="label">贸易条款</text><picker mode="selector" range="{{tradeTerms}}" value="{{tradeTermIndex}}" bindchange="chooseTradeTerm"><view class="picker">{{tradeTerms[tradeTermIndex]}}⌄</view></picker></view></view><text class="label">付款条款</text><input class="input" data-field="paymentTerm" value="{{form.paymentTerm}}" bindinput="onFormInput" placeholder="例如 30% 预付，余款发货前付清"/><view class="two"><view><text class="label">有效期至</text><picker mode="date" value="{{form.validUntil}}" bindchange="onFormInput" data-field="validUntil"><view class="picker">{{form.validUntil}}</view></picker></view><view><text class="label">预计交期（天）</text><input class="input" type="number" data-field="leadTimeDays" value="{{form.leadTimeDays}}" bindinput="onFormInput" placeholder="例如 30"/></view></view><text class="label">备注</text><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="onFormInput" placeholder="包装、装运、报价范围等补充说明"/></view><view class="section-head"><view class="section-title">报价明细</view><button class="secondary mini" bindtap="addItem">＋ 添加</button></view><view wx:for="{{items}}" wx:key="key" class="card item"><view class="row"><strong>第 {{index + 1}} 项</strong><button wx:if="{{items.length > 1}}" class="remove" data-index="{{index}}" bindtap="removeItem">删除</button></view><text class="label">产品描述</text><input class="input" data-index="{{index}}" data-field="name" value="{{item.name}}" bindinput="onItemInput" placeholder="产品名称"/><text class="label">规格</text><input class="input" data-index="{{index}}" data-field="specification" value="{{item.specification}}" bindinput="onItemInput" placeholder="型号、尺寸或材质"/><view class="three"><view><text class="label">单位</text><input class="input" data-index="{{index}}" data-field="unit" value="{{item.unit}}" bindinput="onItemInput"/></view><view><text class="label">数量</text><input class="input" type="digit" data-index="{{index}}" data-field="quantity" value="{{item.quantity}}" bindinput="onItemInput"/></view><view><text class="label">单价</text><input class="input" type="digit" data-index="{{index}}" data-field="unitPrice" value="{{item.unitPrice}}" bindinput="onItemInput"/></view></view><text class="label">行备注</text><input class="input" data-index="{{index}}" data-field="remark" value="{{item.remark}}" bindinput="onItemInput" placeholder="可选"/></view><button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{saving ? '保存中…' : id ? '保存并生成新版本' : '保存报价草稿'}}</button></block></view>
