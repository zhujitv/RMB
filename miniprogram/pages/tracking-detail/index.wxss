.detail-head { background: linear-gradient(140deg, #12392c, #1c6e50); color: #fff; border-radius: 25rpx; padding: 36rpx 30rpx; margin-bottom: 22rpx; }
.detail-head .muted { color: rgba(255,255,255,.65); }
.main-status { font-size: 42rpx; font-weight: 700; margin: 13rpx 0 30rpx; }
.route { font-size: 25rpx; display: flex; justify-content: space-between; }
.info-row { display: flex; justify-content: space-between; gap: 30rpx; line-height: 2.15; font-size: 25rpx; }
.info-row text:first-child { color: #829189; flex: 0 0 130rpx; }
.info-row text:last-child { text-align: right; }
.section-title { font-size: 30rpx; font-weight: 650; margin: 35rpx 4rpx 18rpx; }
.timeline { padding: 28rpx 24rpx 8rpx; }
.event { display: flex; min-height: 115rpx; }
.rail { width: 42rpx; display: flex; flex-direction: column; align-items: center; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #afbeb7; margin-top: 8rpx; }
.dot.active { width: 22rpx; height: 22rpx; background: #1d8b61; box-shadow: 0 0 0 8rpx #ddf0e7; }
.stick { width: 2rpx; flex: 1; background: #dfe7e3; margin: 6rpx 0; }
.event-body { flex: 1; padding-left: 12rpx; padding-bottom: 30rpx; }
.event-title { font-size: 26rpx; font-weight: 600; line-height: 1.45; }
.event-meta, .event-vessel { color: #819089; font-size: 22rpx; margin-top: 7rpx; }
.map-card { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.map-title { color: #183d30; font-size: 28rpx; font-weight: 650; }
.map-desc { max-width: 390rpx; margin-top: 8rpx; color: #819089; font-size: 22rpx; line-height: 1.5; }
.map-button { flex: 0 0 190rpx; height: 72rpx; line-height: 72rpx; font-size: 24rpx; }
.map-button.disabled { background: #e4ebe7; color: #87958e; }
.customs-info { margin-top: 20rpx; }
.event-source { color: #718078; font-size: 22rpx; margin-top: 6rpx; }
