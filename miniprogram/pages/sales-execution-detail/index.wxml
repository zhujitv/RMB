<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取详情…</view><block wx:elif="{{row}}"><view class="hero"><view class="eyebrow">{{row.statusDisplay}} · {{row.sourceDisplay}}</view><view class="title">{{row.executionNo}}</view><view class="subtitle">{{row.customerShortName || row.customerNameSnapshot}} · 客户订单 {{row.customerOrderNo}}</view></view><view class="card details"><view><text>销售金额</text><strong>{{row.currency}} {{row.totalAmount}}</strong></view><view><text>要求交货</text><strong>{{row.requestedDeliveryDate}}</strong></view><view><text>贸易条款</text><strong>{{row.tradeTerm || '-'}}</strong></view><view><text>付款条款</text><strong>{{row.paymentTerm || '-'}}</strong></view><view><text>当前版本</text><strong>V{{row.currentVersionNumber}}</strong></view></view><view class="section-title block-title">销售明细</view><view wx:for="{{row.items}}" wx:key="id" class="card"><view class="row"><strong>{{index + 1}}. {{item.productNameSnapshot || item.name}}</strong><text>{{row.currency}} {{item.salesAmount || item.amount}}</text></view><view class="muted">{{item.specificationSnapshot || item.specification}}</view><view class="numbers"><text>{{item.quantity}} {{item.unit}}</text><text>销售单价 {{item.salesUnitPrice}}</text></view></view><view class="section-title block-title">工厂采购分配</view><view wx:if="{{!row.purchaseOrders.length}}" class="card empty">尚未形成工厂采购单。</view><view wx:for="{{row.purchaseOrders}}" wx:key="id" class="card"><view class="row"><strong>{{item.purchaseOrderNo || item.orderNo}}</strong><view class="status">{{item.status}}</view></view><view class="muted">{{item.supplierName || item.supplier.supplierName}}</view></view></block></view>
