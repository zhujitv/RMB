.hero { background: linear-gradient(145deg,#12372a,#1d6a4e); color:#fff; border-radius:26rpx; padding:34rpx; margin-bottom:22rpx; }.hero .subtitle{color:rgba(255,255,255,.75)}.eyebrow{font-size:22rpx;letter-spacing:2rpx;opacity:.75;margin-bottom:10rpx}.tabs{display:grid;grid-template-columns:1fr 1fr;background:#e5ebe7;border-radius:16rpx;padding:6rpx;margin-bottom:18rpx}.tab{text-align:center;padding:18rpx;color:#68766f;border-radius:12rpx}.tab.active{background:#fff;color:#155d43;font-weight:700;box-shadow:0 3rpx 10rpx rgba(0,0,0,.07)}.toolbar{display:flex;gap:14rpx;padding:16rpx}.search{flex:1;background:#f5f7f5;border-radius:12rpx;padding:0 18rpx;min-height:72rpx}.small{min-height:68rpx;line-height:68rpx;padding:0 24rpx;margin:0}.filter{display:flex;justify-content:space-between;padding:20rpx 24rpx}.customer .section-title,.quote .section-title{margin-bottom:5rpx}.legal-name{font-size:23rpx}.arrow{font-size:50rpx;color:#718078}.details{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #edf0ee}.details view,.quote-metrics view{display:flex;flex-direction:column;gap:5rpx}.details text,.quote-metrics text{font-size:22rpx;color:#7a8780}.details strong,.quote-metrics strong{font-size:25rpx;word-break:break-all}.open-hint{margin-top:20rpx;color:#176c4e;font-size:23rpx}.create{margin-bottom:18rpx}.count{margin:12rpx 4rpx 18rpx}.quote-metrics{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:12rpx;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #edf0ee}.pagination{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0}
