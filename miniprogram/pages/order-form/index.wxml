<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在准备订单表单…</view><block wx:else><view class="card"><view class="section-title">订单与客户</view><text class="label">客户</text><picker mode="selector" range="{{customerNames}}" value="{{customerIndex}}" bindchange="chooseCustomer"><view class="picker">{{customerIndex >= 0 ? customerNames[customerIndex] : '请选择客户'}}<text>⌄</text></view></picker><text class="label">订单号</text><input class="input" data-field="orderNo" value="{{form.orderNo}}" bindinput="onInput" placeholder="客户合同号或内部订单号"/><text class="label">业务主体</text><picker mode="selector" range="{{entityNames}}" value="{{entityIndex}}" bindchange="chooseEntity"><view class="picker">{{entityIndex >= 0 ? entityNames[entityIndex] : '请选择业务主体'}}<text>⌄</text></view></picker></view><view class="card"><view class="section-title">应收金额</view><view class="two"><view><text class="label">币种</text><picker mode="selector" range="{{currencies}}" value="{{currencyIndex}}" bindchange="chooseCurrency"><view class="picker">{{currencies[currencyIndex]}}⌄</view></picker></view><view><text class="label">汇率（兑人民币）</text><input class="input" type="digit" data-field="exchangeRate" value="{{form.exchangeRate}}" bindinput="onInput"/></view></view><text class="label">预计应收金额</text><input class="input" type="digit" data-field="estimatedReceivableAmount" value="{{form.estimatedReceivableAmount}}" bindinput="onInput"/><text class="label">最终应收金额（可暂不填）</text><input class="input" type="digit" data-field="finalReceivableAmount" value="{{form.finalReceivableAmount}}" bindinput="onInput"/></view><view class="card"><view class="section-title">贸易与付款</view><text class="label">贸易条款</text><picker mode="selector" range="{{terms}}" value="{{termIndex}}" bindchange="chooseTerm"><view class="picker">{{terms[termIndex]}}⌄</view></picker><block wx:if="{{form.tradeTerm !== 'EXW'}}"><text class="label">物流供应商</text><picker mode="selector" range="{{supplierNames}}" value="{{supplierIndex}}" bindchange="chooseSupplier"><view class="picker">{{supplierIndex >= 0 ? supplierNames[supplierIndex] : '请选择物流供应商'}}<text>⌄</text></view></picker></block><text class="label">付款条款</text><picker mode="selector" range="{{payments}}" value="{{paymentIndex}}" bindchange="choosePayment"><view class="picker">{{payments[paymentIndex]}}⌄</view></picker><input wx:if="{{form.paymentTermType === 'CUSTOM'}}" class="input" data-field="paymentTerm" value="{{form.paymentTerm}}" bindinput="onInput" placeholder="填写付款约定"/><input wx:if="{{form.paymentTermType === 'OA' || form.paymentTermType === 'AFTER_ARRIVAL'}}" class="input" type="number" data-field="creditDays" value="{{form.creditDays}}" bindinput="onInput" placeholder="账期天数"/><text class="label">预计付款日期（可选）</text><picker mode="date" value="{{form.dueDate}}" data-field="dueDate" bindchange="onInput"><view class="picker">{{form.dueDate || '请选择日期'}}</view></picker><text class="label">提前提醒天数</text><input class="input" type="number" data-field="reminderDays" value="{{form.reminderDays}}" bindinput="onInput"/><text class="label">备注</text><textarea class="textarea" data-field="remark" value="{{form.remark}}" bindinput="onInput"/></view><button class="primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">{{saving ? '保存中…' : '保存应收订单草稿'}}</button></block></view>
