.hero{background:linear-gradient(145deg,#4a3219,#93672a);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:22rpx}.hero .subtitle{color:rgba(255,255,255,.76)}.eyebrow{font-size:22rpx;opacity:.78;margin-bottom:10rpx}.metrics{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx}.metrics .card{padding:18rpx 14rpx}.metrics text{display:block;font-size:21rpx;color:#7a8780}.metrics strong{display:block;margin-top:8rpx;font-size:23rpx}.details view{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #edf0ee}.details text{color:#718078}.details strong{text-align:right}
