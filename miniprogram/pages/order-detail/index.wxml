<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取订单详情…</view><block wx:elif="{{order}}"><view class="hero"><view class="eyebrow">{{order.status}}</view><view class="title">{{order.orderNo}}</view><view class="subtitle">{{order.customerShortName || order.customerName}}</view></view><view class="actions"><button wx:if="{{canWriteOrder}}" class="secondary" bindtap="edit">编辑订单</button><button wx:if="{{canWritePayment}}" class="primary" bindtap="payment">登记收款</button><button wx:if="{{canWriteOrder && order.status === '草稿'}}" class="danger" loading="{{acting}}" bindtap="remove">删除草稿</button></view><view class="metrics"><view class="card"><text>应收</text><strong>{{order.currency}} {{order.finalReceivableAmount}}</strong></view><view class="card"><text>已到账</text><strong>{{order.currency}} {{order.summary.arrivedPaymentsAmount || order.summary.confirmedPaymentsAmount || 0}}</strong></view><view class="card"><text>未收</text><strong>{{order.currency}} {{order.summary.arrivedOutstandingAmount || order.summary.outstandingAmount || order.finalReceivableAmount}}</strong></view></view><view class="card details"><view><text>业务主体</text><strong>{{order.businessEntityDisplayName || order.businessEntityName}}</strong></view><view><text>提单号</text><strong>{{order.blNo || '-'}}</strong></view><view><text>贸易条款</text><strong>{{order.tradeTerm || '-'}}</strong></view><view><text>付款条款</text><strong>{{order.paymentTermDisplay || order.paymentTerm || '-'}}</strong></view><view><text>预计付款</text><strong>{{order.dueDate || order.expectedPaymentDate || '-'}}</strong></view><view><text>业务员</text><strong>{{order.salespersonName || '-'}}</strong></view></view><view wx:if="{{order.remark}}" class="card"><view class="section-title">备注</view><view class="muted">{{order.remark}}</view></view></block></view>
