.profile-card { display: flex; align-items: center; gap: 25rpx; padding: 34rpx; margin-bottom: 24rpx; background: linear-gradient(135deg, #11382b, #1d6d4f); color: #fff; border-radius: 25rpx; }
.avatar { width: 95rpx; height: 95rpx; border-radius: 28rpx; background: #4bc18d; display: flex; align-items: center; justify-content: center; font-size: 42rpx; font-weight: 700; }
.name { font-size: 34rpx; font-weight: 650; margin-bottom: 6rpx; }
.profile-card .muted { color: rgba(255,255,255,.68); font-size: 23rpx; }
.profile-card .tag { margin-top: 13rpx; background: rgba(255,255,255,.15); color: #fff; }
.item { min-height: 76rpx; border-bottom: 1rpx solid #edf1ef; font-size: 25rpx; }
.item:last-child { border-bottom: 0; }
.item text:last-child { color: #73837c; }
.foot { text-align: center; color: #96a29d; font-size: 21rpx; margin: 25rpx; }
