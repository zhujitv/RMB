<view class="page"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在准备报价发送信息…</view><block wx:elif="{{quotation}}"><view class="card"><view class="section-title">发送报价邮件</view><view class="muted">系统会附上当前 V{{draft.versionNumber || quotation.currentVersionNumber}} 英文形式发票 PDF。</view><text class="label">收件邮箱</text><input class="input" data-field="recipientEmails" value="{{recipientEmails}}" bindinput="input" placeholder="多个邮箱用逗号分隔"/><text class="label">抄送邮箱</text><input class="input" data-field="ccEmails" value="{{ccEmails}}" bindinput="input"/><text class="label">邮件标题</text><input class="input" data-field="subject" value="{{subject}}" bindinput="input"/><text class="label">邮件正文</text><textarea class="textarea mail" data-field="body" value="{{body}}" bindinput="input"/><button class="primary submit" loading="{{saving}}" disabled="{{saving || draft.templateEnabled === false}}" bindtap="sendEmail">发送报价和 PDF</button><view wx:if="{{draft.templateEnabled === false}}" class="error">报价邮件模板已停用，请先由管理员启用。</view></view><view class="card"><view class="section-title">登记客户线下接受</view><view class="muted">适用于微信、电话、WhatsApp 或业务员外部邮箱确认。</view><text class="label">确认渠道</text><picker range="{{channels}}" value="{{channelIndex}}" bindchange="chooseChannel"><view class="picker">{{channels[channelIndex]}}<text>⌄</text></view></picker><text class="label">客户确认日期</text><picker mode="date" value="{{confirmationDate}}" end="{{confirmationDate}}" data-field="confirmationDate" bindchange="input"><view class="picker">{{confirmationDate}}</view></picker><text class="label">确认备注（可选）</text><textarea class="textarea" data-field="note" value="{{note}}" bindinput="input" placeholder="联系人、确认内容或凭证位置"/><button class="secondary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="confirmAccepted">确认客户已接受</button></view></block></view>
