<view class="page login-page">
  <view class="brand-card">
    <view class="eyebrow">NEXTWOOD · RMB</view>
    <view class="title">RMB 业务协同</view>
    <view class="subtitle">一个入口访问与你账号权限对应的业务、待办与协同功能。</view>
  </view>
  <view class="card form-card">
    <view class="section-title">登录现有 RMB 账号</view>
    <text class="label">邮箱</text>
    <input class="input" type="text" value="{{email}}" bindinput="onEmail" placeholder="请输入邮箱" />
    <text class="label">密码</text>
    <input class="input" password value="{{password}}" bindinput="onPassword" placeholder="请输入密码" confirm-type="done" bindconfirm="submit" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '登录中…' : '登录'}}</button>
    <view class="hint">登录后将按账号角色和权限显示可用模块，与 RMB 网页端共用同一套账号。</view>
  </view>
</view>
