.hero{background:linear-gradient(145deg,#193c31,#27765a);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:20rpx}.hero .subtitle{color:rgba(255,255,255,.74)}.eyebrow{font-size:22rpx;opacity:.78;margin-bottom:9rpx}.picker{min-height:78rpx;box-sizing:border-box;padding:20rpx 22rpx;background:#fff;border:1rpx solid #dce4df;border-radius:14rpx;margin-bottom:14rpx;display:flex;justify-content:space-between}.search{margin:0 0 22rpx;background:#fff}.record .section-title{margin:0;max-width:76%}.line{display:flex;justify-content:space-between;gap:24rpx;border-top:1rpx solid #edf0ee;padding:16rpx 0}.line:first-of-type{margin-top:18rpx}.line text{color:#728079}.line strong{text-align:right}.amount{font-size:42rpx;color:#176c4e;font-weight:700;margin-top:18rpx}.summary{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.summary .card{padding:18rpx}.summary text{display:block;color:#718078;font-size:22rpx}.summary strong{display:block;margin-top:8rpx;color:#145b42}.open{color:#176c4e;text-align:right;border-top:1rpx solid #edf0ee;padding-top:16rpx;margin-top:10rpx}
