<view class="page"><view class="hero"><view class="eyebrow">RMB 移动工作台</view><view class="title">{{title}}</view><view class="subtitle">真实业务数据 · 共 {{total}} 条</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{canCreate}}" class="primary create" bindtap="create">＋ 新增业务记录</button><picker wx:if="{{reports.length}}" range="{{reportNames}}" value="{{reportIndex}}" bindchange="chooseReport"><view class="picker">{{reportNames[reportIndex]}}<text>⌄</text></view></picker><input class="input search" value="{{keyword}}" bindinput="inputKeyword" placeholder="搜索当前结果"/><view wx:if="{{summary.length}}" class="summary"><view wx:for="{{summary}}" wx:key="label" class="card"><text>{{item.label}}</text><strong>{{item.value}}</strong></view></view><view wx:if="{{loading}}" class="loading">正在同步数据…</view><view wx:elif="{{!cards.length}}" class="card empty">当前筛选条件下暂无记录。</view><view wx:for="{{cards}}" wx:key="id" class="card record" data-index="{{index}}" bindtap="openCard"><view class="row"><view class="section-title">{{item.title}}</view><view wx:if="{{item.status && item.status !== '-'}}" class="status">{{item.status}}</view></view><view wx:if="{{item.amount}}" class="amount">{{item.amount}}</view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="label" class="line"><text>{{line.label}}</text><strong>{{line.value}}</strong></view><view wx:if="{{actionable}}" class="open">查看详情与操作 ›</view></view></view>
