.hero{background:linear-gradient(145deg,#4a3219,#93672a);color:#fff;border-radius:26rpx;padding:34rpx;margin-bottom:22rpx}.hero .subtitle{color:rgba(255,255,255,.76)}.eyebrow{font-size:22rpx;letter-spacing:2rpx;opacity:.76;margin-bottom:10rpx}.toolbar{display:flex;gap:14rpx;padding:16rpx}.search{flex:1;background:#f5f7f5;border-radius:12rpx;padding:0 18rpx;min-height:72rpx}.small{min-height:68rpx;line-height:68rpx;padding:0 24rpx;margin:0}.filter{display:flex;justify-content:space-between;padding:20rpx 24rpx}.create{margin-bottom:18rpx}.count{margin:12rpx 4rpx 18rpx}.order .section-title{margin-bottom:5rpx}.metrics{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx;border-top:1rpx solid #edf0ee;margin-top:18rpx;padding-top:18rpx}.metrics view{display:flex;flex-direction:column;gap:5rpx}.metrics text{font-size:21rpx;color:#7a8780}.metrics strong{font-size:24rpx}.outstanding{color:#a34f1e}.due{margin-top:18rpx;color:#78654b;font-size:23rpx}.pagination{display:flex;align-items:center;justify-content:space-between;margin:26rpx 0}
