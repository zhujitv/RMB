model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rateToCny Decimal  @map("rate_to_cny") @db.Decimal(18, 6)
  rateDate  DateTime @map("rate_date") @db.Date
  source    String
  rateType  String   @map("rate_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([currency, rateDate, source, rateType])
  @@index([currency, rateDate])
  @@map("exchange_rates")
}

model TodoReminderLog {
  id             String   @id @default(cuid())
  todoId         String   @map("todo_id")
  todoType       String   @map("todo_type")
  relatedOrderId String?  @map("related_order_id")
  ownerUserId    String   @map("owner_user_id")
  ownerEmail     String   @map("owner_email")
  remindedAt     DateTime @map("reminded_at")
  reminderDate   DateTime @map("reminder_date") @db.Date
  overdueDays    Int      @map("overdue_days")
  emailStatus    String   @map("email_status")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  owner User @relation("TodoReminderLogOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([todoId, ownerUserId, reminderDate], map: "todo_reminder_logs_daily_unique")
  @@index([todoType])
  @@index([relatedOrderId])
  @@index([ownerUserId])
  @@index([reminderDate])
  @@index([emailStatus])
  @@map("todo_reminder_logs")
}

model NotificationTemplate {
  id                  String   @id @default(cuid())
  type                String   @unique
  name                String
  module              String
  description         String?
  enabled             Boolean  @default(true)
  editable            Boolean  @default(true)
  supportsAttachments Boolean  @default(false) @map("supports_attachments")
  securitySensitive   Boolean  @default(false) @map("security_sensitive")
  subjectTemplate     String   @map("subject_template")
  bodyTemplate        String   @map("body_template")
  variables           Json?
  recipientConfig     Json?    @map("recipient_config")
  ccEmails            Json?    @map("cc_emails")
  ccAdminEmails       Boolean  @default(false) @map("cc_admin_emails")
  extraConfig         Json?    @map("extra_config")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  outboxRows   NotificationOutbox[]
  deliveryLogs NotificationDeliveryLog[]

  @@index([module])
  @@index([enabled])
  @@map("notification_templates")
}

model NotificationOutbox {
  id                String    @id @default(cuid())
  type              String
  channel           String    @default("EMAIL")
  templateId        String?   @map("template_id")
  idempotencyKey    String?   @unique @map("idempotency_key")
  status            String    @default("pending")
  recipientEmails   Json      @map("recipient_emails")
  recipientPhones   Json?     @map("recipient_phones")
  ccEmails          Json?     @map("cc_emails")
  subject           String
  body              String
  attachments       Json?
  context           Json?
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  relatedOrderId    String?   @map("related_order_id")
  attempts          Int       @default(0)
  scheduledAt       DateTime  @default(now()) @map("scheduled_at")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  template     NotificationTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveryLogs NotificationDeliveryLog[]

  @@index([type])
  @@index([channel, status, scheduledAt])
  @@index([templateId])
  @@index([status])
  @@index([relatedOrderId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([scheduledAt])
  @@map("notification_outbox")
}

model NotificationDeliveryLog {
  id                String    @id @default(cuid())
  outboxId          String?   @map("outbox_id")
  templateId        String?   @map("template_id")
  type              String
  channel           String    @default("EMAIL")
  status            String
  recipientEmails   Json      @map("recipient_emails")
  recipientPhones   Json?     @map("recipient_phones")
  ccEmails          Json?     @map("cc_emails")
  subject           String
  bodyPreview       String?   @map("body_preview")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  relatedOrderId    String?   @map("related_order_id")
  errorMessage      String?   @map("error_message")
  provider          String?
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  outbox   NotificationOutbox?   @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([outboxId])
  @@index([templateId])
  @@index([type])
  @@index([status])
  @@index([relatedOrderId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([sentAt])
  @@index([createdAt])
  @@map("notification_delivery_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
