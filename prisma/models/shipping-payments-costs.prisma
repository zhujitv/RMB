model ShippingDocumentNotification {
  id                String    @id @default(cuid())
  orderId           String    @map("order_id")
  customerId        String    @map("customer_id")
  invoiceId         String?   @map("invoice_id")
  sentById          String?   @map("sent_by_id")
  recipientEmails   Json      @map("recipient_emails")
  ccEmails          Json?     @map("cc_emails")
  documentTypes     Json      @map("document_types")
  attachmentFileIds Json      @map("attachment_file_ids")
  sendStatus        String    @default("pending") @map("send_status")
  sendMode          String    @default("auto") @map("send_mode")
  deliveryMethod    String?   @map("delivery_method")
  manualRemark      String?   @map("manual_remark")
  isSystemSent      Boolean   @default(true) @map("is_system_sent")
  emailLanguage     String?   @map("email_language")
  emailSubject      String?   @map("email_subject")
  emailBody         String?   @map("email_body")
  errorMessage      String?   @map("error_message")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order    ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  sentBy   User?           @relation("ShippingDocumentNotificationSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([sentById])
  @@index([sendStatus])
  @@index([sendMode])
  @@index([sentAt])
  @@map("shipping_document_notifications")
}

model Payment {
  id                 String    @id @default(cuid())
  orderId            String    @map("order_id")
  paymentDate        DateTime  @map("payment_date") @db.Date
  currency           String    @default("USD")
  exchangeRate       Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate   DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource String?   @map("exchange_rate_source")
  exchangeRateType   String?   @map("exchange_rate_type")
  amount             Decimal   @db.Decimal(18, 2)
  amountCny          Decimal   @map("amount_cny") @db.Decimal(18, 2)
  paymentType        String    @default("") @map("payment_type")
  status             String    @default("待确认")
  bankReference      String?   @map("bank_reference")
  remark             String?
  createdById        String?   @map("created_by")
  updatedById        String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  order     ReceivableOrder @relation(fields: [orderId], references: [id])
  createdBy User?           @relation("PaymentsCreated", fields: [createdById], references: [id])
  updatedBy User?           @relation("PaymentsUpdated", fields: [updatedById], references: [id])

  @@index([orderId])
  @@index([paymentDate])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, status, paymentDate], map: "payments_status_date_idx")
  @@index([deletedAt, orderId, status], map: "payments_order_status_idx")
  @@map("payments")
}

model OrderCost {
  id                       String    @id @default(cuid())
  orderId                  String    @map("order_id")
  supplierId               String?   @map("supplier_id")
  supplierNameSnapshot     String    @default("") @map("supplier_name_snapshot")
  costType                 String    @map("cost_type")
  vendorName               String    @map("vendor_name")
  currency                 String    @default("CNY")
  exchangeRate             Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate         DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource       String?   @map("exchange_rate_source")
  exchangeRateType         String?   @map("exchange_rate_type")
  amount                   Decimal   @db.Decimal(18, 2)
  amountCny                Decimal   @map("amount_cny") @db.Decimal(18, 2)
  paymentStatus            String    @default("待支付") @map("payment_status")
  status                   String    @default("ACTIVE")
  voidedAt                 DateTime? @map("voided_at")
  voidedById               String?   @map("voided_by")
  voidReason               String?   @map("void_reason") @db.Text
  restoredAt               DateTime? @map("restored_at")
  restoredById             String?   @map("restored_by")
  restoreReason            String?   @map("restore_reason") @db.Text
  costConfirmed            Boolean   @default(false) @map("cost_confirmed")
  costConfirmedAt          DateTime? @map("cost_confirmed_at")
  paymentDate              DateTime? @map("payment_date") @db.Date
  paid                     Boolean   @default(false)
  paidAt                   DateTime? @map("paid_at")
  paymentVoucherUrl        String?   @map("payment_voucher_url")
  paymentVoucherFileName   String?   @map("payment_voucher_file_name")
  paymentVoucherMimeType   String?   @map("payment_voucher_mime_type")
  paymentVoucherUploadedAt DateTime? @map("payment_voucher_uploaded_at")
  paymentVoucherStorageKey String?   @map("payment_voucher_storage_key")
  paymentVoucherBucket     String?   @map("payment_voucher_bucket")
  invoiceStatus            String    @default("未收到") @map("invoice_status")
  sourceType               String    @default("MANUAL") @map("source_type")
  sourceId                 String?   @map("source_id")
  remark                   String?
  createdById              String?   @map("created_by")
  updatedById              String?   @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  order                     ReceivableOrder   @relation(fields: [orderId], references: [id])
  supplier                  Supplier?         @relation(fields: [supplierId], references: [id])
  createdBy                 User?             @relation("CostsCreated", fields: [createdById], references: [id])
  updatedBy                 User?             @relation("CostsUpdated", fields: [updatedById], references: [id])
  documents                 OrderDocument[]
  generatedLogisticsExpense LogisticsExpense? @relation("LogisticsExpenseGeneratedCost")
  supplierDocumentRequests  SupplierDocumentRequest[]

  @@unique([sourceType, sourceId], map: "order_costs_source_unique")
  @@index([orderId])
  @@index([supplierId])
  @@index([costType])
  @@index([paymentStatus])
  @@index([status])
  @@index([voidedAt])
  @@index([paid])
  @@index([paidAt])
  @@index([costConfirmed])
  @@index([sourceType])
  @@index([sourceId])
  @@index([orderId, supplierId, costType, amount, createdById, createdAt], map: "order_costs_duplicate_lookup_idx")
  @@index([deletedAt])
  @@index([deletedAt, updatedAt, createdAt], map: "order_costs_list_sort_idx")
  @@index([deletedAt, invoiceStatus, paymentStatus, updatedAt], map: "order_costs_invoice_payment_idx")
  @@index([deletedAt, sourceType, orderId, supplierId, currency], map: "order_costs_source_group_idx")
  @@index([deletedAt, costType, updatedAt], map: "order_costs_type_updated_idx")
  @@map("order_costs")
}
