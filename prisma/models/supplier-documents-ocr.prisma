model SupplierDocumentRequest {
  id                    String    @id @default(cuid())
  orderId               String    @map("order_id")
  purchaseOrderNo       String?   @map("purchase_order_no")
  supplierId            String    @map("supplier_id")
  costId                String?   @map("cost_id")
  requestedById         String?   @map("requested_by")
  completedById         String?   @map("completed_by")
  requiredDocumentTypes Json      @map("required_document_types")
  status                String    @default("待上传")
  completedAt           DateTime? @map("completed_at")
  dueDate               DateTime? @map("due_date") @db.Date
  message               String?
  templateFileName      String?   @map("template_file_name")
  templateOriginalName  String?   @map("template_original_name")
  templateMimeType      String?   @map("template_mime_type")
  templateFileSize      Int?      @map("template_file_size")
  templateStorageKey    String?   @map("template_storage_key")
  templateBucket        String?   @map("template_bucket")
  recipientEmails       Json?     @map("recipient_emails")
  ccEmails              Json?     @map("cc_emails")
  sendStatus            String    @default("pending") @map("send_status")
  sendError             String?   @map("send_error")
  emailSubject          String?   @map("email_subject")
  emailBody             String?   @map("email_body")
  sentAt                DateTime? @map("sent_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  deletedById           String?   @map("deleted_by")

  order       ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  cost        OrderCost?      @relation(fields: [costId], references: [id], onDelete: SetNull)
  requestedBy User?           @relation("SupplierDocumentRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  completedBy User?           @relation("SupplierDocumentRequestCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  deletedBy   User?           @relation("SupplierDocumentRequestDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  documents   OrderDocument[]
  ocrTasks    OcrTask[]

  @@index([orderId])
  @@index([purchaseOrderNo])
  @@index([supplierId])
  @@index([costId])
  @@index([requestedById])
  @@index([completedById])
  @@index([deletedById])
  @@index([status])
  @@index([sendStatus])
  @@index([dueDate])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([deletedAt, status, dueDate], map: "supplier_document_requests_status_due_idx")
  @@index([deletedAt, supplierId, status], map: "supplier_document_requests_supplier_status_idx")
  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "supplier_document_requests_rank_created_id_idx")
  @@index([deletedAt, supplierId, createdAt(sort: Desc), id(sort: Desc)], map: "supplier_document_requests_supplier_rank_created_id_idx")
  @@map("supplier_document_requests")
}

model OcrTask {
  id               String    @id @default(cuid())
  module           String
  documentId       String    @map("document_id")
  requestId        String?   @map("request_id")
  orderId          String?   @map("order_id")
  supplierId       String?   @map("supplier_id")
  documentType     String    @map("document_type")
  status           String    @default("OCR识别中")
  validationStatus String?   @map("validation_status")
  errorMessage     String?   @map("error_message")
  rawText          String?   @map("raw_text")
  resultJson       Json?     @map("result_json")
  validationJson   Json?     @map("validation_json")
  confirmedById    String?   @map("confirmed_by_id")
  confirmedAt      DateTime? @map("confirmed_at")
  rejectedById     String?   @map("rejected_by_id")
  rejectedAt       DateTime? @map("rejected_at")
  rejectReason     String?   @map("reject_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  document    OrderDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  request     SupplierDocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  order       ReceivableOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplier    Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  confirmedBy User?                    @relation("OcrTaskConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  rejectedBy  User?                    @relation("OcrTaskRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  results     OcrResult[]

  @@index([module])
  @@index([documentId])
  @@index([requestId])
  @@index([orderId])
  @@index([supplierId])
  @@index([status])
  @@index([validationStatus])
  @@index([documentType])
  @@map("ocr_tasks")
}

model OcrRawResult {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  taxRefundId  String?  @map("tax_refund_id")
  orderId      String?  @map("order_id")
  documentType String   @map("document_type")
  provider     String   @default("ALIYUN")
  apiName      String   @map("api_name")
  rawJson      Json?    @map("raw_json")
  parsedJson   Json?    @map("parsed_json")
  confidence   Decimal? @db.Decimal(8, 4)
  status       String   @default("SUCCESS")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document OrderDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order    ReceivableOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([taxRefundId])
  @@index([orderId])
  @@index([documentType])
  @@index([provider, apiName])
  @@index([status])
  @@map("ocr_raw_results")
}

model OcrResult {
  id         String   @id @default(cuid())
  taskId     String   @map("task_id")
  fieldKey   String   @map("field_key")
  label      String
  value      String?
  rawValue   String?  @map("raw_value")
  confidence Decimal? @db.Decimal(8, 4)
  createdAt  DateTime @default(now()) @map("created_at")

  task OcrTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([fieldKey])
  @@map("ocr_results")
}
