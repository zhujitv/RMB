model LogisticsBill {
  id                       String    @id @default(cuid())
  billKey                  String    @unique @map("bill_key")
  orderId                  String    @map("order_id")
  supplierId               String?   @map("supplier_id")
  billOfLadingNo           String    @default("") @map("bill_of_lading_no")
  auditStatus              String    @default("草稿") @map("audit_status")
  invoiceStatus            String    @default("待开票") @map("invoice_status")
  paymentStatus            String    @default("待开票") @map("payment_status")
  status                   String    @default("normal")
  submittedById            String?   @map("submitted_by")
  submittedAt              DateTime? @map("submitted_at")
  reviewedById             String?   @map("reviewed_by")
  reviewedAt               DateTime? @map("reviewed_at")
  reviewRemark             String?   @map("review_remark")
  rejectReason             String?   @map("reject_reason")
  voidedById               String?   @map("voided_by")
  voidedAt                 DateTime? @map("voided_at")
  voidReason               String?   @map("void_reason") @db.Text
  voidRemark               String?   @map("void_remark") @db.Text
  invoiceNotifiedAt        DateTime? @map("invoice_notified_at")
  invoiceNotificationError String?   @map("invoice_notification_error")
  paymentDate              DateTime? @map("payment_date") @db.Date
  createdById              String?   @map("created_by")
  updatedById              String?   @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  order       ReceivableOrder    @relation(fields: [orderId], references: [id])
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  submittedBy User?              @relation("LogisticsBillSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?              @relation("LogisticsBillReviewedBy", fields: [reviewedById], references: [id])
  voidedBy    User?              @relation("LogisticsBillVoidedBy", fields: [voidedById], references: [id])
  createdBy   User?              @relation("LogisticsBillCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("LogisticsBillUpdatedBy", fields: [updatedById], references: [id])
  expenses    LogisticsExpense[]

  @@index([orderId])
  @@index([supplierId])
  @@index([billOfLadingNo])
  @@index([status])
  @@index([voidedAt])
  @@index([auditStatus])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([billOfLadingNo, auditStatus], map: "logistics_bills_shipment_status_idx")
  @@index([supplierId, auditStatus], map: "logistics_bills_supplier_status_idx")
  @@index([orderId, auditStatus], map: "logistics_bills_order_status_idx")
  @@index([submittedById])
  @@index([reviewedById])
  @@index([voidedById])
  @@index([deletedAt])
  @@index([deletedAt, status, updatedAt], map: "logistics_bills_void_status_idx")
  @@index([deletedAt, auditStatus, invoiceStatus, paymentStatus, updatedAt], map: "logistics_bills_workflow_idx")
  @@index([deletedAt, supplierId, auditStatus, updatedAt], map: "logistics_bills_supplier_workflow_idx")
  @@index([deletedAt, orderId, updatedAt], map: "logistics_bills_order_updated_idx")
  @@map("logistics_bills")
}

model LogisticsExpense {
  id                         String    @id @default(cuid())
  billId                     String?   @map("bill_id")
  orderId                    String    @map("order_id")
  supplierId                 String    @map("supplier_id")
  costId                     String?   @unique @map("cost_id")
  supplierNameSnapshot       String    @default("") @map("supplier_name_snapshot")
  costType                   String    @map("cost_type")
  currency                   String    @default("CNY")
  exchangeRate               Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate           DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource         String?   @map("exchange_rate_source")
  exchangeRateType           String?   @map("exchange_rate_type")
  amount                     Decimal   @db.Decimal(18, 2)
  amountCny                  Decimal   @map("amount_cny") @db.Decimal(18, 2)
  containerType              String?   @map("container_type")
  appliedContainerCount      Int?      @map("applied_container_count")
  billingMethod              String?   @map("billing_method")
  billingQuantity            Decimal?  @map("billing_quantity") @db.Decimal(18, 4)
  remark                     String?
  auditStatus                String    @default("草稿") @map("audit_status")
  invoiceStatus              String    @default("待开票") @map("invoice_status")
  paymentStatus              String    @default("待开票") @map("payment_status")
  submittedAt                DateTime? @map("submitted_at")
  reviewedById               String?   @map("reviewed_by")
  reviewedAt                 DateTime? @map("reviewed_at")
  reviewRemark               String?   @map("review_remark")
  rejectReason               String?   @map("reject_reason")
  invoiceNotifiedAt          DateTime? @map("invoice_notified_at")
  invoiceNotificationError   String?   @map("invoice_notification_error")
  invoiceDocumentId          String?   @map("invoice_document_id")
  invoiceUploadedById        String?   @map("invoice_uploaded_by")
  invoiceUploadedAt          DateTime? @map("invoice_uploaded_at")
  invoiceConfirmedById       String?   @map("invoice_confirmed_by")
  invoiceConfirmedAt         DateTime? @map("invoice_confirmed_at")
  invoiceValidationStatus    String    @default("未上传") @map("invoice_validation_status")
  invoiceValidationMessage   String?   @map("invoice_validation_message") @db.Text
  invoiceValidationJson      Json?     @map("invoice_validation_json")
  invoiceOcrTaskId           String?   @map("invoice_ocr_task_id")
  invoiceRecognizedNo        String?   @map("invoice_recognized_no")
  invoiceRecognizedDate      DateTime? @map("invoice_recognized_date") @db.Date
  invoiceRecognizedSeller    String?   @map("invoice_recognized_seller")
  invoiceRecognizedBuyer     String?   @map("invoice_recognized_buyer")
  invoiceRecognizedAmount    Decimal?  @map("invoice_recognized_amount") @db.Decimal(18, 2)
  invoiceRecognizedName      String?   @map("invoice_recognized_name") @db.Text
  invoiceManualConfirmedById String?   @map("invoice_manual_confirmed_by")
  invoiceManualConfirmedAt   DateTime? @map("invoice_manual_confirmed_at")
  invoiceManualConfirmReason String?   @map("invoice_manual_confirm_reason") @db.Text
  forceConfirmReason         String?   @map("force_confirm_reason")
  createdById                String?   @map("created_by")
  updatedById                String?   @map("updated_by")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  deletedAt                  DateTime? @map("deleted_at")

  bill               LogisticsBill?  @relation(fields: [billId], references: [id])
  order              ReceivableOrder @relation(fields: [orderId], references: [id])
  supplier           Supplier        @relation(fields: [supplierId], references: [id])
  cost               OrderCost?      @relation("LogisticsExpenseGeneratedCost", fields: [costId], references: [id])
  createdBy          User?           @relation("LogisticsExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?           @relation("LogisticsExpenseUpdatedBy", fields: [updatedById], references: [id])
  reviewedBy         User?           @relation("LogisticsExpenseReviewedBy", fields: [reviewedById], references: [id])
  invoiceDocument    OrderDocument?  @relation("LogisticsExpenseInvoiceDocument", fields: [invoiceDocumentId], references: [id])
  invoiceUploadedBy  User?           @relation("LogisticsExpenseInvoiceUploadedBy", fields: [invoiceUploadedById], references: [id])
  invoiceConfirmedBy User?           @relation("LogisticsExpenseInvoiceConfirmedBy", fields: [invoiceConfirmedById], references: [id])

  @@index([billId])
  @@index([orderId])
  @@index([supplierId])
  @@index([costId])
  @@index([costType])
  @@index([auditStatus])
  @@index([invoiceStatus])
  @@index([invoiceValidationStatus])
  @@index([invoiceOcrTaskId])
  @@index([invoiceDocumentId])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([reviewedById])
  @@index([deletedAt])
  @@index([deletedAt, billId, createdAt], map: "logistics_expenses_bill_rows_idx")
  @@index([deletedAt, orderId, supplierId], map: "logistics_expenses_order_supplier_idx")
  @@index([deletedAt, costType, updatedAt], map: "logistics_expenses_type_updated_idx")
  @@map("logistics_expenses")
}

model OrderLogisticsSupplier {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  supplierId   String   @map("supplier_id")
  assignedById String?  @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order      ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  assignedBy User?           @relation("OrderLogisticsSupplierAssignedBy", fields: [assignedById], references: [id])

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId])
  @@index([assignedById])
  @@map("order_logistics_suppliers")
}
