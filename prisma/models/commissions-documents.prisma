model CommissionSettlement {
  id                           String    @id @default(cuid())
  orderId                      String    @map("order_id")
  salespersonUserId            String?   @map("salesperson_user_id")
  commissionRate               Decimal   @map("commission_rate") @db.Decimal(8, 2)
  paidAmountCny                Decimal   @map("paid_amount_cny") @db.Decimal(18, 2)
  logisticsCostCny             Decimal   @map("logistics_cost_cny") @db.Decimal(18, 2)
  commissionBaseCny            Decimal   @map("commission_base_cny") @db.Decimal(18, 2)
  commissionAmountCny          Decimal   @map("commission_amount_cny") @db.Decimal(18, 2)
  commissionFormulaMode        String?   @map("commission_formula_mode")
  commissionFormulaLabel       String?   @map("commission_formula_label")
  commissionFormulaDescription String?   @map("commission_formula_description") @db.Text
  commissionFormulaSource      String?   @map("commission_formula_source")
  commissionFormulaDeductions  Json?     @map("commission_formula_deductions")
  commissionFormulaFloorAtZero Boolean?  @map("commission_formula_floor_at_zero")
  commissionFormulaVersion     String    @default("v1") @map("commission_formula_version")
  settledById                  String    @map("settled_by")
  settledAt                    DateTime  @default(now()) @map("settled_at")
  status                       String    @default("ACTIVE")
  reversedAt                   DateTime? @map("reversed_at")
  reversedById                 String?   @map("reversed_by")
  reversalReason               String?   @map("reversal_reason") @db.Text
  remark                       String?
  createdAt                    DateTime  @default(now()) @map("created_at")

  order       ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesperson User?           @relation("CommissionSettlementSalesperson", fields: [salespersonUserId], references: [id])
  settledBy   User            @relation("CommissionSettlementSettledBy", fields: [settledById], references: [id])
  reversedBy  User?           @relation("CommissionSettlementReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, status, settledAt])
  @@index([salespersonUserId])
  @@index([settledById])
  @@index([reversedById])
  @@index([settledAt])
  @@index([reversedAt])
  @@map("commission_settlements")
}

model OrderDocument {
  id                       String            @id @default(cuid())
  orderId                  String            @map("order_id")
  costId                   String?           @map("cost_id")
  supplierId               String?           @map("supplier_id")
  factoryDocumentRequestId String?           @map("factory_document_request_id")
  relatedModule            String            @default("EXPORT") @map("related_module")
  documentType             OrderDocumentType @map("document_type")
  fileName                 String            @map("file_name")
  originalName             String?           @map("original_name")
  originalFilename         String?           @map("original_filename")
  standardFilename         String?           @map("standard_filename")
  fileSize                 Int               @map("file_size")
  mimeType                 String            @map("mime_type")
  r2Bucket                 String            @map("r2_bucket")
  storageKey               String            @map("r2_key")
  fileUrl                  String?           @map("file_url")
  uploadStatus             UploadStatus      @default(PENDING) @map("upload_status")
  uploadProgress           Int               @default(0) @map("upload_progress")
  uploadedById             String?           @map("uploaded_by")
  uploadedAt               DateTime?         @map("uploaded_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  deletedAt                DateTime?         @map("deleted_at")

  order                    ReceivableOrder          @relation(fields: [orderId], references: [id])
  cost                     OrderCost?               @relation(fields: [costId], references: [id])
  supplier                 Supplier?                @relation(fields: [supplierId], references: [id])
  factoryDocumentRequest   SupplierDocumentRequest? @relation(fields: [factoryDocumentRequestId], references: [id], onDelete: SetNull)
  uploadedBy               User?                    @relation("DocumentsUploaded", fields: [uploadedById], references: [id])
  logisticsExpenseInvoices LogisticsExpense[]       @relation("LogisticsExpenseInvoiceDocument")
  ocrTasks                 OcrTask[]
  ocrRawResults            OcrRawResult[]

  @@index([orderId])
  @@index([costId])
  @@index([supplierId])
  @@index([factoryDocumentRequestId])
  @@index([relatedModule])
  @@index([documentType])
  @@index([uploadStatus])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([deletedAt, orderId, relatedModule, documentType, uploadStatus], map: "order_documents_order_module_status_idx")
  @@index([deletedAt, supplierId, documentType, uploadStatus], map: "order_documents_supplier_status_idx")
  @@index([factoryDocumentRequestId, deletedAt], map: "order_documents_factory_request_deleted_idx")
  @@map("order_documents")
}

model FileAsset {
  id                        String    @id @default(cuid())
  fileUrl                   String?   @map("file_url")
  fileName                  String    @map("file_name")
  originalFileName          String?   @map("original_file_name")
  mimeType                  String    @map("mime_type")
  fileSize                  Int?      @map("file_size")
  storageKey                String    @map("storage_key")
  bucket                    String?
  uploadedAt                DateTime? @map("uploaded_at")
  uploadedById              String?   @map("uploaded_by")
  bindingType               String    @map("binding_type")
  sourceTable               String    @map("source_table")
  sourceId                  String    @map("source_id")
  fileRole                  String    @map("file_role")
  orderId                   String?   @map("order_id")
  costId                    String?   @map("cost_id")
  supplierId                String?   @map("supplier_id")
  logisticsExpenseId        String?   @map("logistics_expense_id")
  supplierDocumentRequestId String?   @map("supplier_document_request_id")
  orderDocumentId           String?   @map("order_document_id")
  taxRefundDocumentType     String?   @map("tax_refund_document_type")
  relatedModule             String?   @map("related_module")
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  deletedAt                 DateTime? @map("deleted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@unique([sourceTable, sourceId, fileRole], map: "file_assets_source_unique")
  @@index([bindingType])
  @@index([sourceTable, sourceId])
  @@index([fileRole])
  @@index([orderId])
  @@index([costId])
  @@index([supplierId])
  @@index([logisticsExpenseId])
  @@index([supplierDocumentRequestId])
  @@index([orderDocumentId])
  @@index([taxRefundDocumentType])
  @@index([uploadedById])
  @@index([isDeleted])
  @@index([deletedAt])
  @@map("file_assets")
}
