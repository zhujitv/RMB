generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentTermType {
  COPY_BL
  OA
  AFTER_ARRIVAL
  INSTALLMENT
}

enum OrderDocumentType {
  CUSTOMS_ENTRY_FORM
  RELEASE_NOTICE
  CUSTOMS_POWER_OF_ATTORNEY
  BILL_OF_LADING
  COMMERCIAL_INVOICE
  PACKING_LIST
  SALES_CONTRACT
  EXPORT_INVOICE
  SUPPLIER_PURCHASE_CONTRACT
  SUPPLIER_INVOICE
}

enum UploadStatus {
  PENDING
  UPLOADING
  SUCCESS
  FAILED
}

enum DomesticLogisticsDocumentCategory {
  CUSTOMS_DECLARATION
  CUSTOMS_RELEASE_NOTICE
  CUSTOMS_POWER_OF_ATTORNEY
  CUSTOMS_FEE_INVOICE
  TRUCKING_FEE_INVOICE
  OTHER
}
