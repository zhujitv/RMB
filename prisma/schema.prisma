generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceDate    DateTime @db.Date
  invoiceNo      String?
  orderNo        String
  blNo           String?
  salesperson    String?
  customer       String
  country        String?
  currency       String   @default("USD")
  amount         Decimal  @db.Decimal(18, 2)
  rate           Decimal  @db.Decimal(18, 6)
  creditDays     Int?
  dueDate        DateTime? @db.Date
  reminderDays   Int      @default(7)
  reminderTarget String   @default("财务和业务员")
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceDate])
  @@index([orderNo])
  @@index([blNo])
}

model Receipt {
  id          String   @id @default(cuid())
  receiptDate DateTime @db.Date
  orderNo     String
  customer    String
  country     String?
  currency    String   @default("USD")
  amount      Decimal  @db.Decimal(18, 2)
  rate        Decimal  @db.Decimal(18, 6)
  status      String   @default("已到账")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([receiptDate])
  @@index([orderNo])
}

model Cost {
  id        String   @id @default(cuid())
  costDate  DateTime @db.Date
  orderNo   String
  type      String
  payee     String
  currency  String   @default("CNY")
  amount    Decimal  @db.Decimal(18, 2)
  rate      Decimal  @db.Decimal(18, 6)
  status    String   @default("已支付")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([costDate])
  @@index([orderNo])
  @@index([type])
}
