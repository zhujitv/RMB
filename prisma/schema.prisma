  supplier                  Supplier?         @relation(fields: [supplierId], references: [id])
  createdBy                 User?             @relation("CostsCreated", fields: [createdById], references: [id])
  updatedBy                 User?             @relation("CostsUpdated", fields: [updatedById], references: [id])
  documents                 OrderDocument[]
  generatedLogisticsExpense LogisticsExpense? @relation("LogisticsExpenseGeneratedCost")

  @@unique([sourceType, sourceId], map: "order_costs_source_unique")
  @@index([orderId])
  @@index([supplierId])
  @@index([costType])
  @@index([paymentStatus])
  @@index([paid])
  @@index([paidAt])
  @@index([costConfirmed])
  @@index([sourceType])
  @@index([sourceId])
  @@index([orderId, supplierId, costType, amount, createdById, createdAt], map: "order_costs_duplicate_lookup_idx")
  @@index([deletedAt])
  @@index([deletedAt, updatedAt, createdAt], map: "order_costs_list_sort_idx")
  @@index([deletedAt, invoiceStatus, paymentStatus, updatedAt], map: "order_costs_invoice_payment_idx")
  @@index([deletedAt, sourceType, orderId, supplierId, currency], map: "order_costs_source_group_idx")
  @@index([deletedAt, costType, updatedAt], map: "order_costs_type_updated_idx")
  @@map("order_costs")
}

model LogisticsBill {
  id                       String    @id @default(cuid())
  billKey                  String    @unique @map("bill_key")
  orderId                  String    @map("order_id")
  supplierId               String?   @map("supplier_id")
  billOfLadingNo           String    @default("") @map("bill_of_lading_no")
  auditStatus              String    @default("草稿") @map("audit_status")
  invoiceStatus            String    @default("未通知") @map("invoice_status")
  paymentStatus            String    @default("待开票") @map("payment_status")
  submittedById            String?   @map("submitted_by")
  submittedAt              DateTime? @map("submitted_at")
  reviewedById             String?   @map("reviewed_by")
  reviewedAt               DateTime? @map("reviewed_at")
  reviewRemark             String?   @map("review_remark")
  rejectReason             String?   @map("reject_reason")
  invoiceNotifiedAt        DateTime? @map("invoice_notified_at")
  invoiceNotificationError String?   @map("invoice_notification_error")
  paymentDate              DateTime? @map("payment_date") @db.Date
  createdById              String?   @map("created_by")
  updatedById              String?   @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  order       ReceivableOrder    @relation(fields: [orderId], references: [id])
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  submittedBy User?              @relation("LogisticsBillSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?              @relation("LogisticsBillReviewedBy", fields: [reviewedById], references: [id])
  createdBy   User?              @relation("LogisticsBillCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("LogisticsBillUpdatedBy", fields: [updatedById], references: [id])
  expenses    LogisticsExpense[]

  @@index([orderId])
  @@index([supplierId])
  @@index([billOfLadingNo])
  @@index([auditStatus])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([billOfLadingNo, auditStatus], map: "logistics_bills_shipment_status_idx")
  @@index([supplierId, auditStatus], map: "logistics_bills_supplier_status_idx")
  @@index([orderId, auditStatus], map: "logistics_bills_order_status_idx")
  @@index([submittedById])
  @@index([reviewedById])
  @@index([deletedAt])
  @@index([deletedAt, auditStatus, invoiceStatus, paymentStatus, updatedAt], map: "logistics_bills_workflow_idx")
  @@index([deletedAt, supplierId, auditStatus, updatedAt], map: "logistics_bills_supplier_workflow_idx")
  @@index([deletedAt, orderId, updatedAt], map: "logistics_bills_order_updated_idx")
  @@map("logistics_bills")
}

model LogisticsExpense {
  id                       String    @id @default(cuid())
  billId                   String?   @map("bill_id")
  orderId                  String    @map("order_id")
  supplierId               String    @map("supplier_id")
  costId                   String?   @unique @map("cost_id")
  supplierNameSnapshot     String    @default("") @map("supplier_name_snapshot")
  costType                 String    @map("cost_type")
  currency                 String    @default("CNY")
  exchangeRate             Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate         DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource       String?   @map("exchange_rate_source")
  exchangeRateType         String?   @map("exchange_rate_type")
  amount                   Decimal   @db.Decimal(18, 2)
  amountCny                Decimal   @map("amount_cny") @db.Decimal(18, 2)
  containerType            String?   @map("container_type")
  appliedContainerCount    Int?      @map("applied_container_count")
  billingMethod            String?   @map("billing_method")
  billingQuantity          Decimal?  @map("billing_quantity") @db.Decimal(18, 4)
  remark                   String?
  auditStatus              String    @default("草稿") @map("audit_status")
  invoiceStatus            String    @default("未通知") @map("invoice_status")
  paymentStatus            String    @default("待开票") @map("payment_status")
  submittedAt              DateTime? @map("submitted_at")
  reviewedById             String?   @map("reviewed_by")
  reviewedAt               DateTime? @map("reviewed_at")
  reviewRemark             String?   @map("review_remark")
  rejectReason             String?   @map("reject_reason")
  invoiceNotifiedAt        DateTime? @map("invoice_notified_at")
  invoiceNotificationError String?   @map("invoice_notification_error")
  invoiceDocumentId        String?   @map("invoice_document_id")
  invoiceUploadedById      String?   @map("invoice_uploaded_by")
  invoiceUploadedAt        DateTime? @map("invoice_uploaded_at")
  invoiceConfirmedById     String?   @map("invoice_confirmed_by")
  invoiceConfirmedAt       DateTime? @map("invoice_confirmed_at")
  forceConfirmReason       String?   @map("force_confirm_reason")
  createdById              String?   @map("created_by")
  updatedById              String?   @map("updated_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  bill               LogisticsBill?  @relation(fields: [billId], references: [id])
  order              ReceivableOrder @relation(fields: [orderId], references: [id])
  supplier           Supplier        @relation(fields: [supplierId], references: [id])
  cost               OrderCost?      @relation("LogisticsExpenseGeneratedCost", fields: [costId], references: [id])
  createdBy          User?           @relation("LogisticsExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy          User?           @relation("LogisticsExpenseUpdatedBy", fields: [updatedById], references: [id])
  reviewedBy         User?           @relation("LogisticsExpenseReviewedBy", fields: [reviewedById], references: [id])
  invoiceDocument    OrderDocument?  @relation("LogisticsExpenseInvoiceDocument", fields: [invoiceDocumentId], references: [id])
  invoiceUploadedBy  User?           @relation("LogisticsExpenseInvoiceUploadedBy", fields: [invoiceUploadedById], references: [id])
  invoiceConfirmedBy User?           @relation("LogisticsExpenseInvoiceConfirmedBy", fields: [invoiceConfirmedById], references: [id])

  @@index([billId])
  @@index([orderId])
  @@index([supplierId])
  @@index([costId])
  @@index([costType])
  @@index([auditStatus])
  @@index([invoiceStatus])
  @@index([invoiceDocumentId])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([reviewedById])
  @@index([deletedAt])
  @@index([deletedAt, billId, createdAt], map: "logistics_expenses_bill_rows_idx")
  @@index([deletedAt, orderId, supplierId], map: "logistics_expenses_order_supplier_idx")
  @@index([deletedAt, costType, updatedAt], map: "logistics_expenses_type_updated_idx")
  @@map("logistics_expenses")
}

model OrderLogisticsSupplier {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  supplierId   String   @map("supplier_id")
  assignedById String?  @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order      ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  assignedBy User?           @relation("OrderLogisticsSupplierAssignedBy", fields: [assignedById], references: [id])

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId])
  @@index([assignedById])
  @@map("order_logistics_suppliers")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rateToCny Decimal  @map("rate_to_cny") @db.Decimal(18, 6)
  rateDate  DateTime @map("rate_date") @db.Date
  source    String
  rateType  String   @map("rate_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([currency, rateDate, source, rateType])
  @@index([currency, rateDate])
  @@map("exchange_rates")
}

model TodoReminderLog {
  id             String   @id @default(cuid())
  todoId         String   @map("todo_id")
  todoType       String   @map("todo_type")
  relatedOrderId String?  @map("related_order_id")
  ownerUserId    String   @map("owner_user_id")
  ownerEmail     String   @map("owner_email")
  remindedAt     DateTime @map("reminded_at")
  reminderDate   DateTime @map("reminder_date") @db.Date
  overdueDays    Int      @map("overdue_days")
  emailStatus    String   @map("email_status")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  owner User @relation("TodoReminderLogOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([todoId, ownerUserId, reminderDate], map: "todo_reminder_logs_daily_unique")
  @@index([todoType])
  @@index([relatedOrderId])
  @@index([ownerUserId])
  @@index([reminderDate])
  @@index([emailStatus])
  @@map("todo_reminder_logs")
}

model NotificationTemplate {
  id                  String   @id @default(cuid())
  type                String   @unique
  name                String
  module              String
  description         String?
  enabled             Boolean  @default(true)
  editable            Boolean  @default(true)
  supportsAttachments Boolean  @default(false) @map("supports_attachments")
  securitySensitive   Boolean  @default(false) @map("security_sensitive")
  subjectTemplate     String   @map("subject_template")
  bodyTemplate        String   @map("body_template")
  variables           Json?
  recipientConfig     Json?    @map("recipient_config")
  ccEmails            Json?    @map("cc_emails")
  ccAdminEmails       Boolean  @default(false) @map("cc_admin_emails")
  extraConfig         Json?    @map("extra_config")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  outboxRows   NotificationOutbox[]
  deliveryLogs NotificationDeliveryLog[]

  @@index([module])
  @@index([enabled])
  @@map("notification_templates")
}

model NotificationOutbox {
  id                String    @id @default(cuid())
  type              String
  templateId        String?   @map("template_id")
  idempotencyKey    String?   @unique @map("idempotency_key")
  status            String    @default("pending")
  recipientEmails   Json      @map("recipient_emails")
  ccEmails          Json?     @map("cc_emails")
  subject           String
  body              String
  attachments       Json?
  context           Json?
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  relatedOrderId    String?   @map("related_order_id")
  attempts          Int       @default(0)
  scheduledAt       DateTime  @default(now()) @map("scheduled_at")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  template     NotificationTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveryLogs NotificationDeliveryLog[]

  @@index([type])
  @@index([templateId])
  @@index([status])
  @@index([relatedOrderId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([scheduledAt])
  @@map("notification_outbox")
}

model NotificationDeliveryLog {
  id                String    @id @default(cuid())
  outboxId          String?   @map("outbox_id")
  templateId        String?   @map("template_id")
  type              String
  status            String
  recipientEmails   Json      @map("recipient_emails")
  ccEmails          Json?     @map("cc_emails")
  subject           String
  bodyPreview       String?   @map("body_preview")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id")
  relatedOrderId    String?   @map("related_order_id")
  errorMessage      String?   @map("error_message")
  provider          String?
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  outbox   NotificationOutbox?   @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([outboxId])
  @@index([templateId])
  @@index([type])
  @@index([status])
  @@index([relatedOrderId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([sentAt])
  @@index([createdAt])
  @@map("notification_delivery_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model ApiPerformanceLog {
  id         String   @id @default(cuid())
  source     String   @default("server")
  method     String
  path       String
  statusCode Int?     @map("status_code")
  durationMs Int      @map("duration_ms")
  userId     String?  @map("user_id")
  role       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([durationMs])
  @@index([source, createdAt])
  @@index([statusCode, createdAt])
  @@map("api_performance_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
