generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentTermType {
  COPY_BL
  OA
  AFTER_ARRIVAL
  INSTALLMENT
}

enum OrderDocumentType {
  CUSTOMS_ENTRY_FORM
  RELEASE_NOTICE
  CUSTOMS_POWER_OF_ATTORNEY
  BILL_OF_LADING
  COMMERCIAL_INVOICE
  PACKING_LIST
  SALES_CONTRACT
  EXPORT_INVOICE
  SUPPLIER_PURCHASE_CONTRACT
  SUPPLIER_INVOICE
}

enum UploadStatus {
  PENDING
  UPLOADING
  SUCCESS
  FAILED
}

enum DomesticLogisticsDocumentCategory {
  CUSTOMS_DECLARATION
  CUSTOMS_RELEASE_NOTICE
  CUSTOMS_POWER_OF_ATTORNEY
  CUSTOMS_FEE_INVOICE
  TRUCKING_FEE_INVOICE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("业务员")
  phone        String?
  avatarInitials String? @map("avatar_initials")
  defaultLanguage String? @map("default_language")
  customPermissions Json? @map("custom_permissions")
  supplierId    String?   @map("supplier_id")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  approvalStatus String @default("APPROVED") @map("approval_status")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  salesOrders   ReceivableOrder[] @relation("SalesOrders")
  responsibleCustomers Customer[] @relation("CustomerSalesperson")
  createdOrders ReceivableOrder[] @relation("OrdersCreated")
  updatedOrders ReceivableOrder[] @relation("OrdersUpdated")
  createdPayments Payment[] @relation("PaymentsCreated")
  updatedPayments Payment[] @relation("PaymentsUpdated")
  createdCosts OrderCost[] @relation("CostsCreated")
  updatedCosts OrderCost[] @relation("CostsUpdated")
  createdSuppliers Supplier[] @relation("SuppliersCreated")
  updatedSuppliers Supplier[] @relation("SuppliersUpdated")
  uploadedDocuments OrderDocument[] @relation("DocumentsUploaded")
  commissionSettlements ReceivableOrder[] @relation("CommissionSettlements")
  commissionSettlementRecords CommissionSettlement[] @relation("CommissionSettlementSettledBy")
  salespersonCommissionSettlementRecords CommissionSettlement[] @relation("CommissionSettlementSalesperson")
  archivedTaxRefundOrders ReceivableOrder[] @relation("TaxRefundArchivedBy")
  submittedTaxRefundOrders ReceivableOrder[] @relation("TaxRefundSubmittedBy")
  sessions    UserSession[]
  loginAttempts LoginAttempt[]
  auditLogs   AuditLog[]
  supplierOperator Supplier? @relation("SupplierOperators", fields: [supplierId], references: [id])
  submittedDomesticLogistics DomesticLogisticsInfo[] @relation("DomesticLogisticsSubmittedBy")
  confirmedDomesticLogistics DomesticLogisticsInfo[] @relation("DomesticLogisticsFinanceConfirmedBy")
  uploadedDomesticLogisticsDocuments DomesticLogisticsDocument[]
  sentShippingDocumentNotifications ShippingDocumentNotification[] @relation("ShippingDocumentNotificationSentBy")
  createdLogisticsExpenses LogisticsExpense[] @relation("LogisticsExpenseCreatedBy")
  updatedLogisticsExpenses LogisticsExpense[] @relation("LogisticsExpenseUpdatedBy")
  reviewedLogisticsExpenses LogisticsExpense[] @relation("LogisticsExpenseReviewedBy")
  invoiceUploadedLogisticsExpenses LogisticsExpense[] @relation("LogisticsExpenseInvoiceUploadedBy")
  invoiceConfirmedLogisticsExpenses LogisticsExpense[] @relation("LogisticsExpenseInvoiceConfirmedBy")
  assignedOrderLogisticsSuppliers OrderLogisticsSupplier[] @relation("OrderLogisticsSupplierAssignedBy")

  @@index([supplierId])
  @@index([approvalStatus])
  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  email     String?
  ipAddress String?  @map("ip_address")
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([key, createdAt])
  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  shortName       String?   @map("short_name")
  country         String?
  defaultCurrency String?   @map("default_currency")
  salespersonUserId String?   @map("salesperson_user_id")
  commissionRate Decimal   @default(0) @map("commission_rate") @db.Decimal(8, 2)
  commissionStatus String  @default("启用") @map("commission_status")
  contactPerson   String?   @map("contact_person")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  enableAutoShippingDocsNotification Boolean @default(false) @map("enable_auto_shipping_docs_notification")
  shippingDocsEmails Json? @map("shipping_docs_emails")
  shippingDocsCcEmails Json? @map("shipping_docs_cc_emails")
  autoSendDocumentTypes Json? @map("auto_send_document_types")
  clearanceEmailLanguage String @default("EN") @map("clearance_email_language")
  remark          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  salesperson User? @relation("CustomerSalesperson", fields: [salespersonUserId], references: [id])
  orders ReceivableOrder[]
  shippingDocumentNotifications ShippingDocumentNotification[]

  @@index([name])
  @@index([shortName])
  @@index([salespersonUserId])
  @@index([commissionStatus])
  @@index([deletedAt])
  @@map("customers")
}

model Supplier {
  id            String    @id @default(cuid())
  supplierName  String    @map("supplier_name")
  supplierType  String    @default("其他供应商") @map("supplier_type")
  country       String?
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?
  invoiceTitle  String?   @map("invoice_title")
  taxNumber     String?   @map("tax_number")
  bankName      String?   @map("bank_name")
  bankAccount   String?   @map("bank_account")
  remark        String?
  status        String    @default("启用")
  allowDomesticLogisticsEntry Boolean @default(false) @map("allow_domestic_logistics_entry")
  allowLogisticsExpenseEntry Boolean @default(false) @map("allow_logistics_expense_entry")
  allowLogisticsInvoiceUpload Boolean @default(false) @map("allow_logistics_invoice_upload")
  isDefaultLogisticsSupplier Boolean @default(false) @map("is_default_logistics_supplier")
  allowedLogisticsCostTypes Json? @map("allowed_logistics_cost_types")
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  createdBy User?      @relation("SuppliersCreated", fields: [createdById], references: [id])
  updatedBy User?      @relation("SuppliersUpdated", fields: [updatedById], references: [id])
  costs     OrderCost[]
  documents OrderDocument[]
  operatorUsers User[] @relation("SupplierOperators")
  logisticsExpenses LogisticsExpense[]
  assignedOrders OrderLogisticsSupplier[]

  @@index([supplierName])
  @@index([supplierType])
  @@index([status])
  @@index([allowDomesticLogisticsEntry])
  @@index([allowLogisticsExpenseEntry])
  @@index([allowLogisticsInvoiceUpload])
  @@index([isDefaultLogisticsSupplier])
  @@index([deletedAt])
  @@map("suppliers")
}

model ReceivableOrder {
  id                  String    @id @default(cuid())
  orderNo             String    @map("order_no")
  blNo                String?   @map("bl_no")
  customerId          String    @map("customer_id")
  customerNameSnapshot String   @map("customer_name_snapshot")
  salespersonUserId   String?   @map("salesperson_user_id")
  salespersonCommissionRate Decimal @default(0) @map("salesperson_commission_rate") @db.Decimal(8, 2)
  commissionStatus     String    @default("未结算") @map("commission_status")
  commissionSettledById String?  @map("commission_settled_by")
  commissionSettledAt  DateTime? @map("commission_settled_at")
  commissionSettlementRemark String? @map("commission_settlement_remark")
  country             String?
  currency            String
  exchangeRate        Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate    DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource  String?   @map("exchange_rate_source")
  exchangeRateType    String?   @map("exchange_rate_type")
  receivableAmount    Decimal   @map("receivable_amount") @db.Decimal(18, 2)
  receivableAmountCny Decimal   @map("receivable_amount_cny") @db.Decimal(18, 2)
  estimatedReceivableAmount    Decimal   @map("estimated_receivable_amount") @db.Decimal(18, 2)
  estimatedReceivableAmountCny Decimal   @map("estimated_receivable_amount_cny") @db.Decimal(18, 2)
  actualShipmentAmount         Decimal?  @map("actual_shipment_amount") @db.Decimal(18, 2)
  actualShipmentAmountCny      Decimal?  @map("actual_shipment_amount_cny") @db.Decimal(18, 2)
  actualShipmentDate           DateTime? @map("actual_shipment_date") @db.Date
  finalReceivableAmount        Decimal   @map("final_receivable_amount") @db.Decimal(18, 2)
  finalReceivableAmountCny     Decimal   @map("final_receivable_amount_cny") @db.Decimal(18, 2)
  tradeTerm           String    @default("FOB") @map("trade_term")
  paymentTerm         String    @default("OA账期") @map("payment_term")
  paymentTermType     PaymentTermType? @map("payment_term_type")
  depositRatio        Decimal?  @map("deposit_ratio") @db.Decimal(8, 4)
  expectedPaymentDate DateTime? @map("expected_payment_date") @db.Date
  expectedArrivalDate DateTime? @map("expected_arrival_date") @db.Date
  expectedShipmentDate DateTime? @map("expected_shipment_date") @db.Date
  blDate              DateTime? @map("bl_date") @db.Date
  paymentInstallments Json?     @map("payment_installments")
  taxRefundStatus      String    @default("NOT_READY") @map("tax_refund_status")
  taxRefundCompleteness Json?    @map("tax_refund_completeness")
  taxRefundCompletenessUpdatedAt DateTime? @map("tax_refund_completeness_updated_at")
  taxArchived          Boolean   @default(false) @map("tax_archived")
  taxRefundArchivedById String?  @map("tax_refund_archived_by")
  taxRefundArchivedAt DateTime?  @map("tax_refund_archived_at")
  taxRefundArchiveRemark String? @map("tax_refund_archive_remark")
  taxSubmittedById     String?   @map("tax_submitted_by")
  taxSubmittedAt       DateTime? @map("tax_submitted_at")
  customsDeclarationNo String?   @map("customs_declaration_no")
  customsDeclarationDate DateTime? @map("customs_declaration_date") @db.Date
  customsParsedAt      DateTime? @map("customs_parsed_at")
  customsParseStatus   String?   @map("customs_parse_status")
  customsParseMessage  String?   @map("customs_parse_message")
  customsDeclarationParseSource String? @map("customs_declaration_parse_source")
  creditDays          Int?      @map("credit_days")
  dueDate             DateTime? @map("due_date") @db.Date
  reminderDays        Int       @default(7) @map("reminder_days")
  status              String    @default("草稿")
  remark              String?
  createdById         String?   @map("created_by")
  updatedById         String?   @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  customer    Customer @relation(fields: [customerId], references: [id])
  salesperson User?    @relation("SalesOrders", fields: [salespersonUserId], references: [id])
  commissionSettledBy User? @relation("CommissionSettlements", fields: [commissionSettledById], references: [id])
  taxRefundArchivedBy User? @relation("TaxRefundArchivedBy", fields: [taxRefundArchivedById], references: [id])
  taxSubmittedBy User? @relation("TaxRefundSubmittedBy", fields: [taxSubmittedById], references: [id])
  createdBy   User?    @relation("OrdersCreated", fields: [createdById], references: [id])
  updatedBy   User?    @relation("OrdersUpdated", fields: [updatedById], references: [id])
  payments    Payment[]
  costs       OrderCost[]
  documents   OrderDocument[]
  domesticLogisticsInfos DomesticLogisticsInfo[]
  domesticLogisticsDocuments DomesticLogisticsDocument[]
  commissionSettlementRecords CommissionSettlement[]
  shippingDocumentNotifications ShippingDocumentNotification[]
  logisticsExpenses LogisticsExpense[]
  logisticsSuppliers OrderLogisticsSupplier[]

  @@index([orderNo])
  @@index([blNo])
  @@index([customerId])
  @@index([salespersonUserId])
  @@index([commissionStatus])
  @@index([commissionSettledById])
  @@index([status])
  @@index([paymentTermType])
  @@index([taxRefundStatus])
  @@index([taxArchived])
  @@index([taxRefundCompletenessUpdatedAt])
  @@index([taxRefundArchivedAt])
  @@index([taxRefundArchivedById])
  @@index([taxSubmittedAt])
  @@index([taxSubmittedById])
  @@index([customsDeclarationDate])
  @@index([customsParseStatus])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("receivable_orders")
}

model DomesticLogisticsInfo {
  id                    String    @id @default(cuid())
  orderId               String    @map("order_id")
  transportType         String    @map("transport_type")
  truckPlateNo          String?   @map("truck_plate_no")
  trailerPlateNo        String?   @map("trailer_plate_no")
  departurePlace        String?   @map("departure_place")
  destinationPlace      String?   @map("destination_place")
  departureDate         DateTime? @map("departure_date") @db.Date
  expressTrackingNo     String?   @map("express_tracking_no")
  cargoDescription      String?   @map("cargo_description")
  remarkTextManualEdited Boolean   @default(false) @map("remark_text_manual_edited")
  remarkText            String?   @map("remark_text")
  submittedByUserId     String?   @map("submitted_by_user_id")
  submittedAt           DateTime? @map("submitted_at")
  submitterRole         String?   @map("submitter_role")
  financeStatus         String    @default("PENDING") @map("finance_status")
  financeConfirmedById  String?   @map("finance_confirmed_by")
  financeConfirmedAt    DateTime? @map("finance_confirmed_at")
  rejectReason          String?   @map("reject_reason")
  unlockedByUserId      String?   @map("unlocked_by_user_id")
  unlockedAt            DateTime? @map("unlocked_at")
  correctionRequested   Boolean   @default(false) @map("correction_requested")
  correctionReason      String?   @map("correction_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  order ReceivableOrder @relation(fields: [orderId], references: [id])
  submittedBy User? @relation("DomesticLogisticsSubmittedBy", fields: [submittedByUserId], references: [id])
  financeConfirmedBy User? @relation("DomesticLogisticsFinanceConfirmedBy", fields: [financeConfirmedById], references: [id])
  transportItems DomesticLogisticsTransportItem[]

  @@index([orderId])
  @@index([submittedByUserId])
  @@index([financeStatus])
  @@index([submittedAt])
  @@index([deletedAt])
  @@map("domestic_logistics_infos")
}

model DomesticLogisticsTransportItem {
  id                String   @id @default(cuid())
  logisticsInfoId   String   @map("logistics_info_id")
  containerNo       String?  @map("container_no")
  containerType     String?  @map("container_type")
  sealNo            String?  @map("seal_no")
  truckPlateNo      String?  @map("truck_plate_no")
  trailerPlateNo    String?  @map("trailer_plate_no")
  departureDate     DateTime? @map("departure_date") @db.Date
  departurePlace    String?  @map("departure_place")
  arrivalPlace      String?  @map("arrival_place")
  cargoName         String?  @map("cargo_name")
  remark            String?
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  logisticsInfo DomesticLogisticsInfo @relation(fields: [logisticsInfoId], references: [id], onDelete: Cascade)

  @@index([logisticsInfoId])
  @@index([sortOrder])
  @@map("logistics_transport_items")
}

model DomesticLogisticsDocument {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  documentCategory DomesticLogisticsDocumentCategory @map("document_category")
  fileName         String   @map("file_name")
  filePath         String   @map("file_path")
  fileSize         Int      @map("file_size")
  fileType         String   @map("file_type")
  uploadedById     String?  @map("uploaded_by")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")
  version          Int      @default(1)
  status           String   @default("UPLOADED")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order      ReceivableOrder @relation(fields: [orderId], references: [id])
  uploadedBy User?           @relation(fields: [uploadedById], references: [id])

  @@index([orderId])
  @@index([documentCategory])
  @@index([status])
  @@index([uploadedAt])
  @@map("domestic_logistics_documents")
}

model CommissionSettlement {
  id                    String   @id @default(cuid())
  orderId               String   @map("order_id")
  salespersonUserId     String?  @map("salesperson_user_id")
  commissionRate        Decimal  @map("commission_rate") @db.Decimal(8, 2)
  paidAmountCny         Decimal  @map("paid_amount_cny") @db.Decimal(18, 2)
  logisticsCostCny      Decimal  @map("logistics_cost_cny") @db.Decimal(18, 2)
  commissionBaseCny     Decimal  @map("commission_base_cny") @db.Decimal(18, 2)
  commissionAmountCny   Decimal  @map("commission_amount_cny") @db.Decimal(18, 2)
  settledById           String   @map("settled_by")
  settledAt             DateTime @default(now()) @map("settled_at")
  remark                String?
  createdAt             DateTime @default(now()) @map("created_at")

  order       ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesperson User?           @relation("CommissionSettlementSalesperson", fields: [salespersonUserId], references: [id])
  settledBy   User            @relation("CommissionSettlementSettledBy", fields: [settledById], references: [id])

  @@index([orderId])
  @@index([salespersonUserId])
  @@index([settledById])
  @@index([settledAt])
  @@map("commission_settlements")
}

model OrderDocument {
  id             String            @id @default(cuid())
  orderId        String            @map("order_id")
  costId         String?           @map("cost_id")
  supplierId     String?           @map("supplier_id")
  relatedModule  String            @default("EXPORT") @map("related_module")
  documentType   OrderDocumentType @map("document_type")
  fileName       String            @map("file_name")
  originalName   String?           @map("original_name")
  originalFilename String?         @map("original_filename")
  standardFilename String?         @map("standard_filename")
  fileSize       Int               @map("file_size")
  mimeType       String            @map("mime_type")
  r2Bucket       String            @map("r2_bucket")
  storageKey     String            @map("r2_key")
  fileUrl        String?           @map("file_url")
  uploadStatus   UploadStatus      @default(PENDING) @map("upload_status")
  uploadProgress Int               @default(0) @map("upload_progress")
  uploadedById   String?           @map("uploaded_by")
  uploadedAt     DateTime?         @map("uploaded_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  order      ReceivableOrder @relation(fields: [orderId], references: [id])
  cost       OrderCost?      @relation(fields: [costId], references: [id])
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  uploadedBy User?           @relation("DocumentsUploaded", fields: [uploadedById], references: [id])
  logisticsExpenseInvoice LogisticsExpense? @relation("LogisticsExpenseInvoiceDocument")

  @@index([orderId])
  @@index([costId])
  @@index([supplierId])
  @@index([relatedModule])
  @@index([documentType])
  @@index([uploadStatus])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("order_documents")
}

model ShippingDocumentNotification {
  id                String    @id @default(cuid())
  orderId           String    @map("order_id")
  customerId        String    @map("customer_id")
  invoiceId         String?   @map("invoice_id")
  sentById          String?   @map("sent_by_id")
  recipientEmails   Json      @map("recipient_emails")
  ccEmails          Json?     @map("cc_emails")
  documentTypes     Json      @map("document_types")
  attachmentFileIds Json      @map("attachment_file_ids")
  sendStatus        String    @default("pending") @map("send_status")
  sendMode          String    @default("auto") @map("send_mode")
  emailLanguage     String?   @map("email_language")
  emailSubject      String?   @map("email_subject")
  emailBody         String?   @map("email_body")
  errorMessage      String?   @map("error_message")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order    ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  sentBy   User?           @relation("ShippingDocumentNotificationSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([sentById])
  @@index([sendStatus])
  @@index([sendMode])
  @@index([sentAt])
  @@map("shipping_document_notifications")
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  paymentDate   DateTime  @map("payment_date") @db.Date
  currency      String    @default("USD")
  exchangeRate  Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate   DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource String?   @map("exchange_rate_source")
  exchangeRateType   String?   @map("exchange_rate_type")
  amount        Decimal   @db.Decimal(18, 2)
  amountCny     Decimal   @map("amount_cny") @db.Decimal(18, 2)
  paymentType   String    @default("尾款") @map("payment_type")
  status        String    @default("待确认")
  bankReference String?   @map("bank_reference")
  remark        String?
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  order     ReceivableOrder @relation(fields: [orderId], references: [id])
  createdBy User?           @relation("PaymentsCreated", fields: [createdById], references: [id])
  updatedBy User?           @relation("PaymentsUpdated", fields: [updatedById], references: [id])

  @@index([orderId])
  @@index([paymentDate])
  @@index([status])
  @@index([deletedAt])
  @@map("payments")
}

model OrderCost {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  supplierId    String?   @map("supplier_id")
  supplierNameSnapshot String @default("") @map("supplier_name_snapshot")
  costType      String    @map("cost_type")
  vendorName    String    @map("vendor_name")
  currency      String    @default("CNY")
  exchangeRate  Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate   DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource String?   @map("exchange_rate_source")
  exchangeRateType   String?   @map("exchange_rate_type")
  amount        Decimal   @db.Decimal(18, 2)
  amountCny     Decimal   @map("amount_cny") @db.Decimal(18, 2)
  paymentStatus String    @default("待支付") @map("payment_status")
  costConfirmed Boolean   @default(false) @map("cost_confirmed")
  costConfirmedAt DateTime? @map("cost_confirmed_at")
  paymentDate   DateTime? @map("payment_date") @db.Date
  invoiceStatus String    @default("未收到") @map("invoice_status")
  sourceType    String    @default("MANUAL") @map("source_type")
  sourceId      String?   @map("source_id")
  remark        String?
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  order     ReceivableOrder @relation(fields: [orderId], references: [id])
  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  createdBy User?           @relation("CostsCreated", fields: [createdById], references: [id])
  updatedBy User?           @relation("CostsUpdated", fields: [updatedById], references: [id])
  documents OrderDocument[]
  generatedLogisticsExpense LogisticsExpense? @relation("LogisticsExpenseGeneratedCost")

  @@index([orderId])
  @@index([supplierId])
  @@index([costType])
  @@index([paymentStatus])
  @@index([costConfirmed])
  @@index([sourceType])
  @@index([sourceId])
  @@index([orderId, supplierId, costType, amount, createdById, createdAt], map: "order_costs_duplicate_lookup_idx")
  @@index([deletedAt])
  @@unique([sourceType, sourceId], map: "order_costs_source_unique")
  @@map("order_costs")
}

model LogisticsExpense {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  supplierId    String    @map("supplier_id")
  costId        String?   @unique @map("cost_id")
  supplierNameSnapshot String @default("") @map("supplier_name_snapshot")
  costType      String    @map("cost_type")
  currency      String    @default("CNY")
  exchangeRate  Decimal   @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate   DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateSource String?   @map("exchange_rate_source")
  exchangeRateType   String?   @map("exchange_rate_type")
  amount        Decimal   @db.Decimal(18, 2)
  amountCny     Decimal   @map("amount_cny") @db.Decimal(18, 2)
  containerType String?   @map("container_type")
  appliedContainerCount Int? @map("applied_container_count")
  billingMethod String?   @map("billing_method")
  billingQuantity Decimal? @map("billing_quantity") @db.Decimal(18, 4)
  remark        String?
  auditStatus   String    @default("草稿") @map("audit_status")
  invoiceStatus String    @default("未通知") @map("invoice_status")
  paymentStatus String    @default("待开票") @map("payment_status")
  submittedAt   DateTime? @map("submitted_at")
  reviewedById  String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewRemark  String?   @map("review_remark")
  rejectReason  String?   @map("reject_reason")
  invoiceNo     String?   @map("invoice_no")
  invoiceDate   DateTime? @map("invoice_date") @db.Date
  invoiceAmount Decimal?  @map("invoice_amount") @db.Decimal(18, 2)
  invoiceRemark String?   @map("invoice_remark")
  invoiceNotifiedAt DateTime? @map("invoice_notified_at")
  invoiceDocumentId String? @unique @map("invoice_document_id")
  invoiceUploadedById String? @map("invoice_uploaded_by")
  invoiceUploadedAt DateTime? @map("invoice_uploaded_at")
  invoiceConfirmedById String? @map("invoice_confirmed_by")
  invoiceConfirmedAt DateTime? @map("invoice_confirmed_at")
  forceConfirmReason String? @map("force_confirm_reason")
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  order     ReceivableOrder @relation(fields: [orderId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  cost      OrderCost?      @relation("LogisticsExpenseGeneratedCost", fields: [costId], references: [id])
  createdBy User?           @relation("LogisticsExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?           @relation("LogisticsExpenseUpdatedBy", fields: [updatedById], references: [id])
  reviewedBy User?          @relation("LogisticsExpenseReviewedBy", fields: [reviewedById], references: [id])
  invoiceDocument OrderDocument? @relation("LogisticsExpenseInvoiceDocument", fields: [invoiceDocumentId], references: [id])
  invoiceUploadedBy User?   @relation("LogisticsExpenseInvoiceUploadedBy", fields: [invoiceUploadedById], references: [id])
  invoiceConfirmedBy User?  @relation("LogisticsExpenseInvoiceConfirmedBy", fields: [invoiceConfirmedById], references: [id])

  @@index([orderId])
  @@index([supplierId])
  @@index([costId])
  @@index([costType])
  @@index([auditStatus])
  @@index([invoiceStatus])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([reviewedById])
  @@index([deletedAt])
  @@map("logistics_expenses")
}

model OrderLogisticsSupplier {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  supplierId   String   @map("supplier_id")
  assignedById String?  @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  order      ReceivableOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  assignedBy User?           @relation("OrderLogisticsSupplierAssignedBy", fields: [assignedById], references: [id])

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId])
  @@index([assignedById])
  @@map("order_logistics_suppliers")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rateToCny Decimal  @map("rate_to_cny") @db.Decimal(18, 6)
  rateDate  DateTime @map("rate_date") @db.Date
  source    String
  rateType  String   @map("rate_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([currency, rateDate, source, rateType])
  @@index([currency, rateDate])
  @@map("exchange_rates")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
